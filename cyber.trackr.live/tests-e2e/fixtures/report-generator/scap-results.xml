<cdf:Benchmark xmlns:cdf="http://checklists.nist.gov/xccdf/1.2" xmlns:dc="http://purl.org/dc/elements/1.1/" id="xccdf_mil.disa.stig_benchmark_Fixture_OS_STIG" style="SCAP_1.2">
  <cdf:title>Fixture Operating System Security Technical Implementation Guide</cdf:title>
  <cdf:version>1.5</cdf:version>
  <cdf:Group id="xccdf_mil.disa.stig_group_V-300001">
    <cdf:title>SRG-OS-000021-GPOS-00005</cdf:title>
    <cdf:Rule id="xccdf_mil.disa.stig_rule_SV-300001r1_rule" severity="medium">
      <cdf:title>The OS must lock accounts after three failed logons.</cdf:title>
      <cdf:description>Prevents brute force.</cdf:description>
      <cdf:reference><dc:publisher>DISA</dc:publisher></cdf:reference>
      <cdf:ident system="http://cyber.mil/cci">CCI-000044</cdf:ident>
      <cdf:fixtext>Set the lockout threshold to 3.</cdf:fixtext>
      <cdf:fix id="F-300001r1_fix"/>
    </cdf:Rule>
  </cdf:Group>
  <cdf:Group id="xccdf_mil.disa.stig_group_V-300002">
    <cdf:title>SRG-OS-000480-GPOS-00227</cdf:title>
    <cdf:Rule id="xccdf_mil.disa.stig_rule_SV-300002r1_rule" severity="high">
      <cdf:title>The OS must not allow blank passwords.</cdf:title>
      <cdf:description>Blank passwords allow unauthenticated access.</cdf:description>
      <cdf:reference><dc:publisher>DISA</dc:publisher></cdf:reference>
      <cdf:ident system="http://cyber.mil/cci">CCI-000366</cdf:ident>
      <cdf:fixtext>Require passwords on all accounts.</cdf:fixtext>
      <cdf:fix id="F-300002r1_fix"/>
    </cdf:Rule>
  </cdf:Group>
