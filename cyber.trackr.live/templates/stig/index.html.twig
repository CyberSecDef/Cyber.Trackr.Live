{% extends 'base.html.twig' %}
{% block datatables_css %}<link rel="stylesheet" href="{{ asset_v('/css/datatables.min.css') }}" />{% endblock %}
{% block datatables_js %}<script src="{{ asset_v('/js/datatables.min.js') }}"></script>{% endblock %}
{% import 'macros.html.twig' as ui %}

{% block title %}STIGs &mdash; Cyber Trackr{% endblock %}
{% block og_title %}DoD STIGs — every guide, comparable across versions{% endblock %}
{% block og_description %}Browse and search every DISA STIG. Per-version diff, severity counts, Atom feed of recent updates, direct links to each rule's CCIs and 800-53 controls.{% endblock %}
{% block og_image_name %}stig{% endblock %}

{% block body %}
    <section class="lib-page" aria-labelledby="stig-page-title">
        <div class="rule-text">&sect; Library &middot; STIGs</div>

        <header class="lib-page__header">
            <span class="eyebrow">DoD Compliance</span>
            <h1 id="stig-page-title" class="lib-page__title-large">
                Security Technical <em>Implementation Guides</em>
            </h1>
            <p class="lib-page__lede">
                {{ stig_count|number_format }} guides covering operating systems, applications, network devices, and policies &mdash; sourced from DISA and updated as new releases land.
                <a class="lib-page__feed-link" href="{{ path('stig_feed') }}" type="application/atom+xml">
                    <i class="bi bi-rss-fill" aria-hidden="true"></i> Atom feed of recent updates
                </a>
                <a class="lib-page__feed-link" href="{{ path('stig_index_titles') }}">
                    <i class="bi bi-list" aria-hidden="true"></i> Flat A-to-Z index
                </a>
            </p>
        </header>

        <div class="lib-page__bar">
            <div class="lib-page__filter">
                <input id="stig-q" type="search" placeholder="Filter {{ stig_count|number_format }} STIGs by name or version&hellip;"
                       aria-label="Filter STIGs" oninput="window.app.stigList.filter()">
                <div class="chip-group" role="radiogroup" aria-label="Filter by age">
                    <button type="button" class="chip active" data-age="all"   onclick="window.app.stigList.age(this)">All ages</button>
                    <button type="button" class="chip"        data-age="fresh" onclick="window.app.stigList.age(this)">Fresh &le; 1y</button>
                    <button type="button" class="chip"        data-age="stale" onclick="window.app.stigList.age(this)">Stale 1&ndash;3y</button>
                    <button type="button" class="chip"        data-age="aged"  onclick="window.app.stigList.age(this)">Aged 3&ndash;5y</button>
                    <button type="button" class="chip"        data-age="old"   onclick="window.app.stigList.age(this)">Old &gt; 5y</button>
                </div>
            </div>
        </div>

        <div class="lib-page__legend" aria-hidden="true">
            <span><span class="dot fresh"></span> Fresh &middot; &le; 1 yr</span>
            <span><span class="dot stale"></span> Stale &middot; 1&ndash;3 yr</span>
            <span><span class="dot aged"></span>  Aged &middot; 3&ndash;5 yr</span>
            <span><span class="dot old"></span>   Old &middot; &gt; 5 yr</span>
        </div>

        <details class="bulk-dl-panel" data-bulk-panel>
            <summary class="bulk-dl-panel__summary">
                <span class="bulk-dl-panel__summary-label">
                    <i class="bi bi-archive" aria-hidden="true"></i>
                    Bulk download
                </span>
                <span class="bulk-dl-panel__summary-meta">
                    Pick any combination of XCCDF XML + DISA companion ZIPs across every archived version. Bundled into &le;500&nbsp;MB chunks.
                </span>
                <span class="bulk-dl-panel__summary-cta">
                    <a class="bulk-dl-panel__deeplink" href="{{ path('stig_bulk') }}" onclick="event.stopPropagation();">Open full page &rarr;</a>
                </span>
            </summary>
            {# The table (4,031 rows, 5.7 MB) is fetched the first time the panel
               opens; embedding it made every /stig view carry it hidden. #}
            <p class="bulk-dl-panel__status" data-bulk-slot data-src="{{ path('stig_bulk_table') }}" aria-live="polite">Loading the download list&hellip;</p>
        </details>

        <div class="data-table-wrap">
            <div class="data-table-scroll">
                <table id="stig-table" class="data-table">
                    <thead>
                        <tr>
                            <th data-sort-key="name"     data-sort-type="string">Name <span class="sort-ind"></span></th>
                            <th data-sort-key="version"  data-sort-type="string">Version <span class="sort-ind"></span></th>
                            <th data-sort-key="released" data-sort-type="date" class="sorted desc" aria-sort="descending">Released <span class="sort-ind">&darr;</span></th>
                            <th>Severity Mix</th>
                            <th data-sort-key="rules"    data-sort-type="number" class="num">Rules <span class="sort-ind"></span></th>
                            <th>Freshness</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for s in stigs_latest %}
                            {% set hi  = s.sev.h|default(0) %}
                            {% set med = s.sev.m|default(0) %}
                            {% set low = s.sev.l|default(0) %}
                            {% set rules_total = hi + med + low %}
                            {% set rel_trim = s.released|default('')|trim %}
                            {% set tag = rel_trim is empty ? 'old' : (s.released|freshness_tag) %}
                            {% set rel_iso = rel_trim is empty ? '' : (s.released|date('Y-m-d')) %}
                            <tr data-name="{{ s.title|replace({'_': ' '})|lower }}"
                                data-version="V{{ s.version }}R{{ s.release }}"
                                data-age="{{ tag }}"
                                data-released="{{ rel_iso }}"
                                data-rules="{{ rules_total }}">
                                <td data-label="Name"><a href="{{ path('stig_view', {title: s.title, version: s.version, release: s.release}) }}">{{ s.title|replace({'_': ' '}) }}</a></td>
                                <td data-label="Version">{{ ui.ident('V' ~ s.version ~ 'R' ~ s.release) }}</td>
                                <td data-label="Released">{% if rel_trim %}{{ s.released|date("d M Y") }}{% endif %}</td>
                                <td data-label="Severity Mix">
                                    <span class="sev-mix">
                                        {{ ui.sev_bar(hi, med, low) }}
                                        {% if hi  > 0 %}{{ ui.sev('high', hi) }}{% endif %}
                                        {% if med > 0 %}{{ ui.sev('med',  med) }}{% endif %}
                                        {% if low > 0 %}{{ ui.sev('low',  low) }}{% endif %}
                                    </span>
                                </td>
                                <td data-label="Rules" class="num">{{ rules_total|number_format }}</td>
                                <td data-label="Freshness">{% if rel_trim %}{{ ui.freshness(s.released) }}{% endif %}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="data-table-foot">
                <span id="stig-page-info" data-total="{{ stig_count }}" aria-live="polite">Page 1 &middot; {{ stig_count|number_format }} STIGs</span>
                <div class="data-table-foot__pager">
                    <button type="button" id="stig-prev" onclick="window.app.stigList.prev()" disabled>&larr; Prev</button>
                    <button type="button" id="stig-next" onclick="window.app.stigList.next()">Next &rarr;</button>
                </div>
            </div>
        </div>
    </section>

    <script src="{{ asset_v('/js/bulk_download.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const panel = document.querySelector('[data-bulk-panel]');
            if (!panel) return;
            // The first time the panel opens, fetch the table, put it in
            // place of the slot and initialise it (DataTables + selection).
            let loading = null;
            function load() {
                const slot = panel.querySelector('[data-bulk-slot]');
                if (!slot || loading) return;
                loading = fetch(slot.dataset.src, { credentials: 'same-origin' })
                    .then(function (r) {
                        if (!r.ok) throw new Error('HTTP ' + r.status);
                        return r.text();
                    })
                    .then(function (html) {
                        const tpl = document.createElement('template');
                        tpl.innerHTML = html;
                        slot.replaceWith(tpl.content);
                        window.bulkDownload.init(panel.querySelector('[data-bulk-root]'));
                    })
                    .catch(function () {
                        slot.innerHTML = 'Could not load the download list. <a href="{{ path('stig_bulk') }}">Open the full page</a> or close and reopen this panel to retry.';
                        loading = null;
                    });
            }
            panel.addEventListener('toggle', function () {
                if (panel.open) {
                    document.querySelector('.data-table-wrap').classList.add('is-hidden');
                    load();
                } else {
                    document.querySelector('.data-table-wrap').classList.remove('is-hidden');
                }
            });
        });
    </script>
{% endblock %}
