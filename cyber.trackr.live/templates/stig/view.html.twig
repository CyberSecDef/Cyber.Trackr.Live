{% extends 'base.html.twig' %}
{% import 'macros.html.twig' as ui %}

{% set _stig_title    = stig.xpath("/xmlns:Benchmark/xmlns:title")|first|default(title|replace({'_': ' '})) %}
{% set _release_info  = stig.xpath("/xmlns:Benchmark/xmlns:plain-text[@id='release-info']/text()")|first %}
{% set _released_date = _release_info|split('Date:')[1]|default('')|trim %}
{% set _hi_count      = stig.xpath("/xmlns:Benchmark/xmlns:Group/xmlns:Rule[@severity = 'high']")|length %}
{% set _med_count     = stig.xpath("/xmlns:Benchmark/xmlns:Group/xmlns:Rule[@severity = 'medium']")|length %}
{% set _low_count     = stig.xpath("/xmlns:Benchmark/xmlns:Group/xmlns:Rule[@severity = 'low']")|length %}
{% set _rules_total   = _hi_count + _med_count + _low_count %}

{% block title %}View STIG - {{ _stig_title }} V{{ version }}R{{ release }} {% endblock %}
{% block og_title %}{{ _stig_title }} V{{ version }}R{{ release }}{% endblock %}
{# Per-version content-driven description: rule counts, severity mix,
   release date — every (title, V, R) gets a unique meta description.
   Surrounding text trimmed so the dynamic facts dominate. #}
{% block og_description %}{{ _stig_title }} V{{ version }}R{{ release }}{% if _released_date %} ({{ _released_date }}){% endif %} — {{ _rules_total }} rules: {{ _hi_count }} CAT I, {{ _med_count }} CAT II, {{ _low_count }} CAT III. Linked CCIs and 800-53 cross-references.{% endblock %}
{% block og_image_name %}stig{% endblock %}
{% block og_type %}article{% endblock %}

{% block jsonld_extra %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "STIGs",                "item": "{{ absolute_url(path('stig'))|e('js') }}" },
        { "@type": "ListItem", "position": 2, "name": "{{ _stig_title|e('js') }}", "item": "{{ absolute_url(path('stig_index_titles'))|e('js') }}#t-{{ title|e('js') }}" },
        { "@type": "ListItem", "position": 3, "name": "V{{ version }}R{{ release }}", "item": "{{ absolute_url(app.request.uri)|e('js') }}" }
    ]
}
</script>
{% endblock %}

{% block body %}
    {% set xml_title       = stig.xpath("/xmlns:Benchmark/xmlns:title")|first %}
    {% set published_date  = stig.xpath("/xmlns:Benchmark/xmlns:status/@date")|first %}
    {% set release_info    = stig.xpath("/xmlns:Benchmark/xmlns:plain-text[@id='release-info']/text()")|first %}
    {% set released_date   = release_info|split('Date:')[1]|default('')|trim %}
    {% set hi_count        = stig.xpath("/xmlns:Benchmark/xmlns:Group/xmlns:Rule[@severity = 'high']")|length %}
    {% set med_count       = stig.xpath("/xmlns:Benchmark/xmlns:Group/xmlns:Rule[@severity = 'medium']")|length %}
    {% set low_count       = stig.xpath("/xmlns:Benchmark/xmlns:Group/xmlns:Rule[@severity = 'low']")|length %}
    {% set rules_total     = hi_count + med_count + low_count %}

    <article class="stig-detail">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
            <ol>
                <li><a href="{{ path('stig') }}">STIGs</a></li>
                <li>{{ title|replace({'_': ' '}) }}</li>
                <li aria-current="page">V{{ version }}R{{ release }}</li>
            </ol>
        </nav>

        <header class="stig-detail__header">
            <div class="stig-detail__header-text">
                <span class="eyebrow">DoD Compliance &middot; STIG</span>
                <h1 class="stig-detail__title">{{ xml_title }}</h1>
                <div class="stig-detail__meta">
                    {{ ui.ident('V' ~ version ~ 'R' ~ release) }}
                    {% if released_date %}
                        <span>&middot;</span>
                        {{ ui.freshness(released_date) }}
                        <span>&middot; Released {{ released_date|date("d M Y") }}</span>
                    {% endif %}
                    <span>&middot; {{ rules_total|number_format }} rules</span>
                </div>
            </div>
            <div class="stig-detail__actions">
                <button type="button" class="icon-btn" onclick="stig_app.download();" title="Download original XCCDF" aria-label="Download original XCCDF">
                    <i class="bi bi-cloud-download" aria-hidden="true"></i>
                </button>
                <button type="button" class="icon-btn" onclick="pdf_app.exec();" title="Print" aria-label="Print">
                    <i class="bi bi-printer-fill" aria-hidden="true"></i>
                </button>
            </div>
        </header>

        {% if wizard_key %}
            <aside class="stig-wizard-cta" aria-label="STIG checklist wizard">
                <i class="bi bi-magic stig-wizard-cta__icon" aria-hidden="true"></i>
                <div class="stig-wizard-cta__text">
                    <strong>Generate a starter checklist</strong>
                    <p>Answer a short set of questions about your application and download a pre-populated <code>.cklb</code> &mdash; applicable requirements pre-marked with rationale, ready to finish in the checklist viewer. Every auto-determination is flagged for your review.</p>
                </div>
                <a class="cta-primary stig-wizard-cta__btn" href="{{ path('stig_wizard', {title: title, version: version, release: release}) }}">
                    <i class="bi bi-stars" aria-hidden="true"></i>
                    Launch wizard
                </a>
            </aside>
        {% endif %}

        <div class="stat-cards" role="group" aria-label="Severity filters">
            <button type="button" class="stat-card high active" data-bs-toggle="button" aria-pressed="true" onclick="stig_app.toggleFilter(this, 'high');" aria-label="Toggle {{ hi_count }} high-severity rules">
                <span class="stat-card__num">{{ hi_count|number_format }}</span>
                <span class="stat-card__label">High severity</span>
            </button>
            <button type="button" class="stat-card med active" data-bs-toggle="button" aria-pressed="true" onclick="stig_app.toggleFilter(this, 'medium');" aria-label="Toggle {{ med_count }} medium-severity rules">
                <span class="stat-card__num">{{ med_count|number_format }}</span>
                <span class="stat-card__label">Medium severity</span>
            </button>
            <button type="button" class="stat-card low active" data-bs-toggle="button" aria-pressed="true" onclick="stig_app.toggleFilter(this, 'low');" aria-label="Toggle {{ low_count }} low-severity rules">
                <span class="stat-card__num">{{ low_count|number_format }}</span>
                <span class="stat-card__label">Low severity</span>
            </button>
        </div>

        <section class="versions-panel" aria-label="Versions">
            <div class="versions-panel__col">
                <span class="eyebrow">Compare</span>
                <p class="versions-panel__hint">Pick two releases to diff their requirements.</p>
                <div class="versions-panel__controls">
                    <select id="compare_stig1" aria-label="Compare from version">
                        <option value="" selected>From&hellip;</option>
                        {% for s in stigs|sort((a, b) => a.date <=> b.date)|reverse %}
                            <option value="{{s.version}}|{{s.release}}">V{{s.version}}R{{s.release}}</option>
                        {% endfor %}
                    </select>
                    <select id="compare_stig2" aria-label="Compare to version">
                        <option value="" selected>To&hellip;</option>
                        {% for s in stigs|sort((a, b) => a.date <=> b.date)|reverse %}
                            <option value="{{s.version}}|{{s.release}}">V{{s.version}}R{{s.release}}</option>
                        {% endfor %}
                    </select>
                    <button type="button" class="cta-primary" onclick="stig_app.compare()">Compare</button>
                </div>
            </div>
            <div class="versions-panel__col">
                <span class="eyebrow">View</span>
                <p class="versions-panel__hint">Open a previous version of this STIG.</p>
                <div class="versions-panel__controls">
                    <select id="view_stig" aria-label="Open version">
                        <option value="" selected>Choose&hellip;</option>
                        {% for s in stigs|sort((a, b) => a.date <=> b.date)|reverse %}
                            <option value="{{s.version}}|{{s.release}}">V{{s.version}}R{{s.release}}</option>
                        {% endfor %}
                    </select>
                    <button type="button" class="cta-primary" onclick="stig_app.view()">View</button>
                </div>
            </div>
        </section>

        <div class="doc-desc">
            {{ stig.xpath("/xmlns:Benchmark/xmlns:description")|first }}
        </div>

        {% if companion %}
            <details class="stig-companion">
                <summary class="stig-companion__summary">
                    <span class="stig-companion__summary-label">
                        <i class="bi bi-file-earmark-zip" aria-hidden="true"></i>
                        Supporting documents
                    </span>
                    <span class="stig-companion__summary-meta">
                        DISA companion ZIP &middot; {{ (companion.size / 1024 / 1024)|number_format(1) }} MB
                    </span>
                    <span class="stig-companion__summary-counts">
                        {% if companion.pdfs|length %}
                            <span class="stig-companion__count stig-companion__count--pdf">{{ companion.pdfs|length }} PDF{{ companion.pdfs|length == 1 ? '' : 's' }}</span>
                        {% endif %}
                    </span>
                </summary>

                <div class="stig-companion__body">
                    <p class="stig-companion__lede">
                        Bundled by DISA alongside this STIG release: overview, revision history, and readme files. Download the full archive or open an individual PDF.
                    </p>

                    <div class="stig-companion__actions">
                        <a class="cta-primary"
                           href="{{ path('stig_companion_zip', {title: title, version: version, release: release}) }}"
                           download>
                            <i class="bi bi-download" aria-hidden="true"></i>
                            Download full ZIP
                            <span class="stig-companion__file">{{ companion.basename }}</span>
                        </a>
                    </div>

                    {% if companion.pdfs|length %}
                        <ul class="stig-companion__list">
                            {% for pdf in companion.pdfs %}
                                <li>
                                    <a href="{{ path('stig_companion_pdf', {title: title, version: version, release: release, file: pdf.name}) }}" target="_blank" rel="noopener">
                                        <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                                        <span class="stig-companion__pdf-name">{{ pdf.basename }}</span>
                                        <span class="stig-companion__pdf-size">{{ (pdf.size / 1024)|number_format(0) }} KB</span>
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </details>
        {% endif %}

        {% if digest %}
            <details class="stig-digest">
                <summary class="stig-digest__summary">
                    <span class="stig-digest__summary-label">
                        <i class="bi bi-journal-text" aria-hidden="true"></i>
                        Digest of Updates
                    </span>
                    <span class="stig-digest__summary-meta">
                        vs. V{{ digest.previous.version }}R{{ digest.previous.release }}{% if digest.previous.released %} &middot; {{ digest.previous.released }}{% endif %}
                    </span>
                    <span class="stig-digest__summary-counts">
                        {% if digest.totals.added %}
                            <span class="stig-digest__count stig-digest__count--added">+{{ digest.totals.added }}</span>
                        {% endif %}
                        {% if digest.totals.removed %}
                            <span class="stig-digest__count stig-digest__count--removed">&minus;{{ digest.totals.removed }}</span>
                        {% endif %}
                        {% if digest.totals.severity_changed %}
                            <span class="stig-digest__count stig-digest__count--severity">&#9888; {{ digest.totals.severity_changed }}</span>
                        {% endif %}
                        {% if digest.totals.content_changed %}
                            <span class="stig-digest__count stig-digest__count--content">&#9998; {{ digest.totals.content_changed }}</span>
                        {% endif %}
                        {% if digest.totals.added == 0 and digest.totals.removed == 0 and digest.totals.severity_changed == 0 and digest.totals.content_changed == 0 %}
                            <span class="stig-digest__count stig-digest__count--unchanged">No substantive changes</span>
                        {% endif %}
                    </span>
                </summary>

                <div class="stig-digest__body">
                    <p class="stig-digest__lede">
                        Comparison against the immediately-prior release
                        ({{ ui.ident('V' ~ digest.previous.version ~ 'R' ~ digest.previous.release) }}).
                        Rule matching uses the Group Vuln ID. Content-change detection compares the rule&rsquo;s description, check, and fix text after stripping inline markup &mdash; cosmetic-only edits aren&rsquo;t flagged.
                    </p>

                    {% if digest.added|length %}
                        <section class="stig-digest__section stig-digest__section--added">
                            <h3 class="stig-digest__section-title">
                                <i class="bi bi-plus-circle" aria-hidden="true"></i>
                                Added rules <span class="stig-digest__section-count">{{ digest.added|length }}</span>
                            </h3>
                            <ul class="stig-digest__list">
                                {% for r in digest.added %}
                                    <li>
                                        <a href="#{{ r.vuln_id }}">{{ ui.ident(r.vuln_id) }}</a>
                                        <span class="stig-digest__sev stig-digest__sev--{{ r.severity }}">{{ r.severity|title }}</span>
                                        <span class="stig-digest__title-text">{{ r.title }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </section>
                    {% endif %}

                    {% if digest.removed|length %}
                        <section class="stig-digest__section stig-digest__section--removed">
                            <h3 class="stig-digest__section-title">
                                <i class="bi bi-dash-circle" aria-hidden="true"></i>
                                Removed rules <span class="stig-digest__section-count">{{ digest.removed|length }}</span>
                            </h3>
                            <ul class="stig-digest__list">
                                {% for r in digest.removed %}
                                    <li>
                                        {{ ui.ident(r.vuln_id) }}
                                        <span class="stig-digest__sev stig-digest__sev--{{ r.severity }}">{{ r.severity|title }}</span>
                                        <span class="stig-digest__title-text">{{ r.title }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </section>
                    {% endif %}

                    {% if digest.severity_changed|length %}
                        <section class="stig-digest__section stig-digest__section--severity">
                            <h3 class="stig-digest__section-title">
                                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                                Severity changes <span class="stig-digest__section-count">{{ digest.severity_changed|length }}</span>
                            </h3>
                            <ul class="stig-digest__list">
                                {% for r in digest.severity_changed %}
                                    <li>
                                        <a href="#{{ r.vuln_id }}">{{ ui.ident(r.vuln_id) }}</a>
                                        <span class="stig-digest__sev stig-digest__sev--{{ r.old_severity }}">{{ r.old_severity|title }}</span>
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                        <span class="stig-digest__sev stig-digest__sev--{{ r.new_severity }}">{{ r.new_severity|title }}</span>
                                        <span class="stig-digest__title-text">{{ r.title }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </section>
                    {% endif %}

                    {% if digest.content_changed|length %}
                        <section class="stig-digest__section stig-digest__section--content">
                            <h3 class="stig-digest__section-title">
                                <i class="bi bi-pencil" aria-hidden="true"></i>
                                Content changes <span class="stig-digest__section-count">{{ digest.content_changed|length }}</span>
                            </h3>
                            <ul class="stig-digest__list">
                                {% for r in digest.content_changed %}
                                    <li>
                                        <a href="#{{ r.vuln_id }}">{{ ui.ident(r.vuln_id) }}</a>
                                        <span class="stig-digest__sev stig-digest__sev--{{ r.severity }}">{{ r.severity|title }}</span>
                                        <span class="stig-digest__fields">
                                            {% for f in r.fields %}<span class="stig-digest__field-tag">{{ f }}</span>{% endfor %}
                                        </span>
                                        <span class="stig-digest__title-text">{{ r.title }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </section>
                    {% endif %}

                    {% if digest.totals.added == 0 and digest.totals.removed == 0 and digest.totals.severity_changed == 0 and digest.totals.content_changed == 0 %}
                        <p class="stig-digest__empty">No substantive changes detected against the previous release. {{ digest.totals.unchanged|number_format }} rules matched cleanly.</p>
                    {% endif %}
                </div>
            </details>
        {% endif %}

        <div class="rule-controls">
            <div class="rule-controls__group">
                <span class="eyebrow">Sort by</span>
                <div class="chip-group" role="radiogroup" aria-label="Sort rules by">
                    <button type="button" class="chip" role="radio" aria-checked="false" data-sort="control"  onclick="stig_app.sort(this);">Control</button>
                    <button type="button" class="chip" role="radio" aria-checked="false" data-sort="severity" onclick="stig_app.sort(this);">Severity</button>
                    <button type="button" class="chip" role="radio" aria-checked="false" data-sort="vuln"     onclick="stig_app.sort(this);">Vuln</button>
                    <button type="button" class="chip" role="radio" aria-checked="false" data-sort="title"    onclick="stig_app.sort(this);">Title</button>
                </div>
            </div>
            <div class="rule-controls__group">
                <label class="rule-controls__toggle">
                    <input type="checkbox" id="flexSwitchCheckChecked" checked onclick="stig_app.expCol(this);">
                    <span class="eyebrow">Expand all</span>
                </label>
            </div>
        </div>

    <div id="requirements" class="collapse">
        {% for group in stig.xpath("/xmlns:Benchmark/xmlns:Group") %}
            <div class="stig-group requirement {{group.Rule.attributes.severity}}">
                <div class="collapse severity"> 
                    {% if group.Rule.attributes.severity == 'high' %}
                        c
                    {% elseif group.Rule.attributes.severity == 'medium' %}
                        b
                    {% else %}
                        a
                    {% endif %}
                </div>

                {% if group.Rule.ident is defined and group.Rule.ident is not null and group.Rule.ident|length > 0 %}
                    {% set CCI_NUM = group.Rule.ident|filter( v => v.__toString() starts with 'CCI-')|first %}
                {% else %}
                    {% set CCI_NUM = "" %}
                {% endif %}
                
                <div class="req-header title" onclick="stig_app.showhide(this);">
                    <div class="text-md requirement-title">
                        {{group.Rule.title}}
                    </div>
                    <a name="req_{{group.attributes.id}}"></a>
                    <div class="title-details text-md collapse">
                        {% if CCI_NUM != '' %}
                            {% set cci_match = cci.xpath("//xmlns:cci_item[@id='" ~ CCI_NUM ~ "']")|first %}
                            {% if cci_match %}
                                {{ ui.rmf_link(cci_match.references.reference|first.attributes.index|split(' ')|first) }} -
                            {% endif %}
                        {% endif %}
                        {{group.Rule.attributes.severity|title }} -
                        {% if CCI_NUM != '' %}
                            {{ ui.cci_link(CCI_NUM) }} -
                        {% endif %}
                        {{ ui.ident(group.attributes.id) }} -
                        {{ ui.ident(group.Rule.attributes.id) }}
                    </div>
                    
                    
                </div>

                <div class="container-fluid requirement-details">
                    <div class="row">
                        <dl class="col-12 col-lg-2 mb-3 mb-lg-0 p-0 pl-1 g-0 border border-1 bg-light">
                            <dt class="">RMF Control</dt>
                            <dd class="control">
                            {% if CCI_NUM != '' %}
                                {% set cci_match = cci.xpath("//xmlns:cci_item[@id='" ~ CCI_NUM ~ "']")|first %}
                                {% if cci_match %}
                                    {{ ui.rmf_link(cci_match.references.reference|first.attributes.index|split(' ')|first) }}
                                {% endif %}
                            {% endif %}
                            </dd>

                            <dt class="">Severity</dt>
                            <dd>
                                {{ ui.sev(group.Rule.attributes.severity) }}
                            </dd>

                            <dt class="">CCI</dt>
                            <dd class="">{% if CCI_NUM != '' %}{{ ui.cci_link(CCI_NUM) }}{% endif %}</dd>

                            <dt class="">Version</dt>
                            <dd class="">{{ ui.ident(group.Rule.version) }}</dd>

                            <dt class="">Vuln IDs</dt>
                            <dd class="">
                                <ul class="list-unstyled">
                                    <li class="vuln">{{ ui.ident(group.attributes.id) }}</li>
                                    <li>
                                        {% if group.Rule.ident is defined and group.Rule.ident is not null and group.Rule.ident|length > 0 %}
                                            {% set v_id = group.Rule.ident|filter( v => v.__toString() starts with 'V-')|first %}
                                            {% if v_id %}{{ ui.ident(v_id) }}{% endif %}
                                        {% endif %}
                                    </li>
                                </ul>
                            </dd>

                            <dt class="">Rule IDs</dt>
                            <dd class="">
                                <ul class="list-unstyled">
                                    <li>{{ ui.ident(group.Rule.attributes.id) }}</li>
                                    <li>
                                        {% if group.Rule.ident is defined and group.Rule.ident is not null and group.Rule.ident|length > 0 %}
                                            {% set sv_id = group.Rule.ident|filter( v => v.__toString() starts with 'SV-')|first %}
                                            {% if sv_id %}{{ ui.ident(sv_id) }}{% endif %}
                                        {% endif %}
                                    </li>
                                </ul>
                            </dd>                    
                        </dl>
                        <div class="col-12 col-lg-10">

                            <div class="req-desc">
                                {{group.Rule.description|replace({'<Documentable>false</Documentable>':''})|regex_replace('/<[^>]*>/is', '' ) }}
                            </div>

                            <h6><u><strong>Checks</strong>: {{ group.Rule.check.attributes.system }}</u></h6>
                            <p class="pre-wrap">{{ group.Rule.check.asXml()|regex_replace('/<[^>]*>/is', '' ) }}</p>
            
                            <h6><u><strong>Fix: </strong>{{ ui.ident(group.Rule.fix.attributes.id) }}</u></h6>
                            <p class="pre-wrap">{{ group.Rule.fixtext }}</p>

                            <h6> 
                                <button class="btn btn-outline-secondary m-2 py-1 " onclick="stig_app.mitigate(this, '{{ group.attributes.id }}', '{{ group.Rule.title|sha1 }}');"><i class="bi bi-cloud-plus"></i>
                                    <strong>Generate Mitigation Statement:</strong>
                                </button>
                            </h6>
                            <p style="">
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    </article>
<script src="https://cdn.jsdelivr.net/npm/markdown-it@14.1.0/dist/markdown-it.min.js"></script>
    <script>
        const stig_app = {
            md: null,
            init(){
                const expCol = Cookies.get('state')
                if(expCol == 'collapse'){
                    $('#flexSwitchCheckChecked').trigger('click')
                }
                $('#requirements').removeClass('collapse')
                stig_app.md = window.markdownit()
            },
            view(){
                if($('#view_stig').val().trim() != ''){
                    const info = $('#view_stig').val().trim().split('|');
                    window.location.href = "{{ path('stig_view', {title: 'XXXX', version: 9999, release: 8888}) }}"
                        .replace('XXXX',"{{title}}")
                        .replace('9999',info[0])
                        .replace('8888',info[1])
                }
            },
            compare(){
                if($('#compare_stig1').val().trim() != '' && $('#compare_stig2').val().trim() != '' ){
                    const compare_1 = $('#compare_stig1').val().trim().split('|');
                    const compare_2 = $('#compare_stig2').val().trim().split('|');
                    window.location.href = "{{ path('stig_compare', {title: 'XXXX', v1: 9999, r1: 8888, v2: 7777, r2: 6666}) }}"
                            .replace('XXXX',"{{title}}")
                            .replace('9999',compare_1[0])
                            .replace('8888',compare_1[1])
                            .replace('7777',compare_2[0])
                            .replace('6666',compare_2[1])
                }
            },
            download(){
                window.open( window.location.href + '/download' );
            },
            mitigate(elem, vuln_id, m){
                console.log(elem);
                console.log(vuln_id);
                console.log(m);
                let mit = $( elem ).parent().next( 'p' );
                $( elem ).prop('disabled',true); 
                $( mit ).addClass(" border border-secondary ");
		$( mit ).text("Please wait....generating statement")
                $.getJSON( "https://cyber.trackr.live/api/stig/{{title}}/{{version}}/{{release}}/" + vuln_id + "?m=" + m)
  .done(function( json ) {
    $(mit).html( stig_app.md.render( json['mitigation-statement'] ) );
  })
  .fail(function( jqxhr, textStatus, error ) {
    var err = textStatus + ", " + error;
    console.log( "Request Failed: " + err );
}); 
                //$( elem ).parent().next( 'p' ).text( "https://cyber.trackr.live/api/stig/{{title}}/{{version}}/{{release}}/" + vuln_id)
            },
            toggleFilter(elem, level){
                const $groups = $('div.stig-group.' + level);
                if($(elem).hasClass('active')){
                    $groups.removeClass('collapse');
                }else{
                    $groups.removeClass('collapse').addClass('collapse');
                }
            },
            sort(elem){
                const sort_field = $(elem).data('sort');
                $(elem).parent().find('.chip').removeClass('active').attr('aria-checked', 'false');
                $(elem).addClass('active').attr('aria-checked', 'true');

                const itemsArr = $('div.stig-group').toArray();
                itemsArr.sort((a, b) => {
                    const av = $(a).find('.' + sort_field).text().trim();
                    const bv = $(b).find('.' + sort_field).text().trim();
                    return av === bv ? 0 : (av > bv ? 1 : -1);
                });

                const $req = $('div#requirements').empty();
                itemsArr.forEach(e => $req.append(e));
            },
            expCol(elem){

                if($(elem).is(":checked")){
                    Cookies.set('state', 'expand')                    
                    $('.requirement-details').removeClass('collapse')
                    $('.title-details').removeClass('collapse').addClass('collapse')
                    $('.requirement-title').removeClass('text-truncate')
                }else{
                    Cookies.set('state', 'collapse')
                    $('.requirement-details').removeClass('collapse').addClass('collapse')
                    $('.title-details').removeClass('collapse')
                    $('.requirement-title').addClass('text-truncate')
                }
            },
            showhide(elem){
                if(
                    $(elem).siblings('div.requirement-details').hasClass('collapse')
                ){
                    $(elem).siblings('div.requirement-details').removeClass('collapse');
                    
                }else{
                    $(elem).siblings('div.requirement-details').removeClass('collapse').addClass('collapse');
                }
                
            }
        }

        pdf_app = {
	toTitleCase(str){
	  return str.replace(
		/\w\S*/g,
		text => text.charAt(0).toUpperCase() + text.substring(1).toLowerCase()
	  );
	},
	exec(){
		let printWindow = window.open('', '', 'height=1024,width=1280');
		printWindow.document.write('<html><head><title>' + $("div.doc-title > h1").first().text() + '</title>');
		printWindow.document.write('<style>body{font-family:arial;} ul{list-style: none;}</style>');
		printWindow.document.write('</head><body >');
		
		printWindow.document.write("<h1>" + $("div.doc-title > h1").first().text() +  "</h1>");
		
		$('#requirements > div.requirement').each( (i, e)=>{
			printWindow.document.write("<h2>" + $(e).find("div.requirement-title").text() + "</h2>");
			printWindow.document.write( $(e).find("div.requirement-details > div.row > div.col-10 > div.req-desc").html() );	
		
			printWindow.document.write( "<dl style='display: grid; grid-template-columns: max-content auto;'>" );
			printWindow.document.write( $(e).find("div.requirement-details > div.row > dl").html().replace(/\s+/g,' ') );
			printWindow.document.write ( "</dl>" );

			printWindow.document.write("<h3>Checks</h3>");
			printWindow.document.write("<blockquote>")
			printWindow.document.write("<p style='white-space:pre-wrap;'>"  + $(e).find("div.requirement-details > div.row > div.col-10 > p")[0].innerHTML + "</p>");
			printWindow.document.write("</blockquote>")
			
			printWindow.document.write("<h3>Fixes</h3>");
			printWindow.document.write("<blockquote>")
			printWindow.document.write("<p style='white-space:pre-wrap;'>"  + $(e).find("div.requirement-details > div.row > div.col-10 > p")[1].innerHTML + "</p>");
			printWindow.document.write("</blockquote>")
			printWindow.document.write("<hr />"  )			
		})
		printWindow.document.write('</body></html>');
		printWindow.document.close();
	}
};

