{% extends 'base.html.twig' %}

{% block title %}Contact &mdash; Cyber Trackr{% endblock %}

{% block body %}
    <section class="lib-page" aria-labelledby="contact-page-title">
        <div class="rule-text">&sect; Contact</div>

        <header class="lib-page__header">
            <span class="eyebrow">Get in touch</span>
            <h1 id="contact-page-title" class="lib-page__title-large">
                Feedback &amp; <em>suggestions</em>
            </h1>
            <p class="lib-page__lede">
                Spotted a bug, missing dataset, or have a feature in mind? Send a note &mdash; replies usually go out within a few days.
            </p>
        </header>

        <form class="form-stack" method="POST" action="https://formspree.io/wwwdaze2000@gmail.com">
            <input type="hidden" name="_token" value="YzQtfWv4DaYceDUVik3U2HxyE8h3efySuiu9Tazm">

            <div class="form-field">
                <label for="inputEmail">Your email</label>
                <input type="email" id="inputEmail" name="inputEmail" placeholder="you@example.com" required>
                <span class="form-field__hint">Used only to reply &mdash; never stored or shared.</span>
            </div>

            <div class="form-field">
                <label for="inputSubject">Subject</label>
                <input type="text" id="inputSubject" name="inputSubject" placeholder="Brief summary" required>
            </div>

            <div class="form-field">
                <label for="inputBody">Message</label>
                <textarea id="inputBody" name="inputBody" rows="6" placeholder="Details, repro steps, suggested datasets&hellip;" required></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="cta-primary">
                    Send message
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
        </form>
    </section>
{% endblock %}
