{% extends 'base.html.twig' %}
{% import 'macros.html.twig' as ui %}

{% block title %}Search &mdash; {{ query }}{% endblock %}

{% block body %}
    <section class="lib-page" aria-labelledby="search-page-title">
        <div class="rule-text">&sect; Search results</div>

        <header class="lib-page__header">
            <span class="eyebrow">Library Search</span>
            <h1 id="search-page-title" class="lib-page__title-large">
                Results for <em>{{ query }}</em>
                <button type="button"
                        class="save-search-toggle"
                        data-save-query="{{ query }}"
                        aria-pressed="false"
                        title="Save this search">
                    <i class="bi bi-bookmark" aria-hidden="true"></i>
                    <span data-save-label>Save</span>
                </button>
                <button type="button"
                        id="search-bookmark-trigger"
                        class="saved-search-trigger save-search-trigger--inline"
                        data-saved-search-trigger
                        aria-label="Saved searches"
                        aria-expanded="false"
                        aria-controls="search-bookmark-panel"
                        title="Saved searches">
                    <i class="bi bi-bookmarks" aria-hidden="true"></i>
                    <span class="saved-search-trigger__count" data-saved-count hidden></span>
                </button>
            </h1>
            <div id="search-bookmark-panel" class="saved-search-panel saved-search-panel--inline" hidden role="region" aria-label="Saved searches"></div>
            <p class="lib-page__lede">
                {{ results.rmfv4|length|number_format }} 800-53 r4 controls &middot;
                {{ results.rmfv5|length|number_format }} 800-53 r5 controls &middot;
                {{ results.ccis|length|number_format }} CCIs &middot;
                {{ results.aps|length|number_format }} APs &middot;
                {{ results.vulns|length|number_format }} vulnerability requirements
            </p>
        </header>

        <div class="container-fluid p-0">
            <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <div class="search-section">
                        <div class="search-section__header" onclick="$('#rmfv4_results').toggle();" role="button" aria-expanded="false">
                            <span>800-53 r4 Controls</span>
                            <span class="search-section__count">{{ results.rmfv4|length }}</span>
                        </div>
                        <div class="collapse search-section__body" id="rmfv4_results">
                            {% for c in results.rmfv4 %}
                                <div class="search-section__item">
                                    <div class="search-section__item-title">
                                        <a href="{{ path('rmf_v4_view') }}#rmf_{{c.id}}">
                                            {{ ui.ident(c.id) }} &middot; {{c.title}}
                                        </a>
                                    </div>
                                    <div class="search-section__excerpt">{{c.description|regex_replace('/\\[Withdrawn.*\\]/is', '')}}</div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="search-section">
                        <div class="search-section__header" onclick="$('#rmfv5_results').toggle();" role="button" aria-expanded="false">
                            <span>800-53 r5 Controls</span>
                            <span class="search-section__count">{{ results.rmfv5|length }}</span>
                        </div>
                        <div class="collapse search-section__body" id="rmfv5_results">
                            {% for c in results.rmfv5 %}
                                <div class="search-section__item">
                                    <div class="search-section__item-title">
                                        <a href="{{ path('rmf_v5_view') }}#rmf_{{c.id}}">
                                            {{ ui.ident(c.id) }} &middot; {{c.title}}
                                        </a>
                                    </div>
                                    <div class="search-section__excerpt">{{c.description|regex_replace('/\\[Withdrawn.*\\]/is', '')}}</div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="search-section">
                        <div class="search-section__header" onclick="$('#ccis_results').toggle();" role="button" aria-expanded="false">
                            <span>CCIs</span>
                            <span class="search-section__count">{{ results.ccis|length }}</span>
                        </div>
                        <div class="collapse search-section__body" id="ccis_results">
                            {% for c in results.ccis %}
                                <div class="search-section__item">
                                    <div class="search-section__item-title">{{ ui.cci_link(c.id) }}</div>
                                    <div class="search-section__excerpt">{{c.description|regex_replace('/\\[Withdrawn.*\\]/is', '')}}</div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="search-section">
                        <div class="search-section__header" onclick="$('#aps_results').toggle();" role="button" aria-expanded="false">
                            <span>Assessment Procedures</span>
                            <span class="search-section__count">{{ results.aps|length }}</span>
                        </div>
                        <div class="collapse search-section__body" id="aps_results">
                            {% for c in results.aps %}
                                <div class="search-section__item">
                                    <div class="search-section__item-title">{{ ui.ident(c.id) }} &middot; {{ ui.cci_link(c.title) }}</div>
                                    <div class="search-section__excerpt">
                                        {{c.description}}
                                        {{c.note}}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="search-section">
                        <div class="search-section__header" onclick="$('#vuln_results').toggle();" role="button" aria-expanded="false">
                            <span>Vulnerability Requirements</span>
                            <span class="search-section__count">{{ (results.vulns|length < 500) ? results.vulns|length : '500+' }}</span>
                        </div>
                        <div class="collapse search-section__body" id="vuln_results">
                            {% for c in results.vulns|slice(0,500) %}
                                <div class="search-section__item">
                                    <dl class="m-0 p-0 text-sm search-section__meta">
                                        <dt class="inline">STIG</dt>
                                        <dd><a href="{{ path('stig_view', { title: c.stig_title, version: c.version, release: c.release}) }}">{{c.stig_title|replace({'_': ' '})}}</a></dd>

                                        <dt class="inline">Released</dt>
                                        <dd>{% if c.released|default('')|trim %}{{ ui.freshness(c.released) }}{% else %}<span class="text-muted">unknown</span>{% endif %}</dd>

                                        <dt class="inline">Rule</dt>
                                        <dd>{{c.note}}</dd>

                                        <dt class="inline">Vuln ID</dt>
                                        <dd>
                                            <a href="{{ path('stig_view', { title: c.stig_title, version: c.version, release: c.release}) }}#req_{{c.group}}">
                                                {{ ui.ident(c.vuln) }}
                                            </a>
                                        </dd>

                                        <dt class="inline">Rule ID</dt>
                                        <dd>{{ ui.ident(c.rule) }}</dd>
                                    </dl>

                                    <div class="search-section__excerpt">
                                        {{c.description|regex_replace('/<[^>]*>/is', '')}}
                                        {{c.note|regex_replace('/<[^>]*>/is', '')}}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script>
        const search_app = {
            init(){
                search_app.bolderize('#rmfv4_results');
                search_app.bolderize('#rmfv5_results');
            },
            bolderize(el) {
                $(el).html(
                    $(el).html().replace(/\[([^\]]+)\]/gm, '<strong>[$1]</strong>')
                )
            }
        }

        $(document).ready( () => {
            search_app.init();
        })
    </script>
{% endblock %}
