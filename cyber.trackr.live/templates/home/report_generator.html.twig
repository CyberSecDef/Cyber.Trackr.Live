                    Title : i.title,
                    Family : i.subject_area,
                    Impact : i.impact,
                    Priority : i.priority,
                    CCI : i.cci,
                    Definition : i.definition,
                    Description : i.description
                })
            } );
            return cci_rep;      
        },
    },
    processMessage(message){
        switch( message.data.op.split('.')[0] ){
            case 'reports' :
                switch( message.data.op.split('.')[1] ){
                    case 'cci' :
                        self.webWorker.data.cci = this.reports.cci(message.data.source);
                        self.postMessage(JSON.stringify( self.webWorker.data.cci ))
                        // console.log(self.webWorker);
                        break;
                    case 'rmf' :
                        self.webWorker.data.rmf = this.reports.rmf(message.data.source);
                        self.postMessage(JSON.stringify( self.webWorker.data.rmf ))
                        // console.log(self.webWorker);
                        break;
                    case 'ppsm' :
                        self.webWorker.data.ppsm = this.reports.ppsm(message.data.source);
                        self.postMessage(JSON.stringify( self.webWorker.data.ppsm ))
                        // console.log(self.webWorker);
                        break;
                    case 'software' :
                        self.webWorker.data.software = this.reports.software(message.data.source);
                        self.postMessage(JSON.stringify( self.webWorker.data.software ));
                        break;
                    case 'scaninfo' :
                        self.webWorker.data.scaninfo = this.reports.scaninfo(message.data.source);
                        self.postMessage(JSON.stringify( self.webWorker.data.scaninfo ));
                        break;
                    case 'packages' :
                        self.webWorker.data.packages = this.reports.packages(message.data.source);
                        self.postMessage(JSON.stringify( self.webWorker.data.packages ))
                        // console.log(self.webWorker);
                        break;
                    case 'issues' :
                        self.webWorker.data.issues = this.reports.issues(message.data.source);
                        self.postMessage(JSON.stringify( self.webWorker.data.issues ))
                        // console.log(self.webWorker);
                        break;
                    case 'localUsers' :
                        self.webWorker.data.localUsers = this.reports.localUsers(message.data.source);
                        self.postMessage(JSON.stringify( self.webWorker.data.localUsers ))
                        // console.log(self.webWorker);
                        break;
                    case 'operatingSystems' :
                        self.webWorker.data.operatingSystems = this.reports.operatingSystems(message.data.source);
                        self.postMessage(JSON.stringify( self.webWorker.data.operatingSystems ))
                        // console.log(self.webWorker);
                        break;
                    case 'acasUniqueVuln' :
                        self.webWorker.data.acasUniqueVuln = this.reports.acasUniqueVuln(message.data.source);
                        self.postMessage(JSON.stringify( self.webWorker.data.acasUniqueVuln ))
                        // console.log(self.webWorker);
                        break;
                    case 'acasUniqueIava' :
                        self.webWorker.data.acasUniqueIava = this.reports.acasUniqueIava(message.data.source);
                        self.postMessage(JSON.stringify( self.webWorker.data.acasUniqueIava ))
                        // console.log(self.webWorker);
                        break;
                    case 'patches' :
                        self.webWorker.data.patches = this.reports.patches(message.data.source);
                        self.postMessage(JSON.stringify( self.webWorker.data.patches ))
                        // console.log(self.webWorker);
                        break;
                    case 'summary' :
                        self.webWorker.data.summary = this.reports.summary(message.data.source);
                        self.postMessage(JSON.stringify( self.webWorker.data.summary ))
                        // console.log(self.webWorker);
                        break;
                    case 'raw' :
                        self.webWorker.data.raw = this.reports.raw(message.data.source, message.data.opts);
                        self.postMessage(JSON.stringify( self.webWorker.data.raw ))
                        // console.log(self.webWorker);
                        break;
                }
                break;
        }
    }
}
self.onmessage = function(event){ webWorker.processMessage(event); };
</script>


