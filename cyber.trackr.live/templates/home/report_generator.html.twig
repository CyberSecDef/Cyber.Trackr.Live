            report.results = [];
            rmf.forEach( (f) => {
                report.results.push({
                    'Control' : f.control,
                    'Family' : f.subject_area.trim().length > 0 ? f.subject_area : rmf.filter( rf => rf.control == /([A-Z]{2}-[0-9]+)/ig.exec(f.control)[1] ).map( m => m.subject_area ).find(() => true),
                    'Title' : f.title,
                    'Priority' : f.priority,
                    'Impact' : f.impact,
                    'Description' : f.description
                })
            })

            return report;
        },
        cci(rmf_cci){
            const cci_rep = {};
