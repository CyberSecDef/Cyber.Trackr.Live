                            'Finding Details': r.findingDetails.substr(0, 32760),
                            'SCAP File': scap.scanFile,
                            'CKL File': '',
                            Comments: '',
                        });
                    }
                });
            });
                
                
            let dedup = [];
            const map = new Map();
            for (const item of results) {
            // if(!map.has(item.title + item.hosts + item.grpId + item.vulnId + item.vulnId + item.ruleId + item['SCAP Status'] + item['CKL Status'] + item.Comments)){
                    // map.set(item.title + item.hosts + item.grpId + item.vulnId + item.vulnId + item.ruleId + item['SCAP Status'] + item['CKL Status'] + item.Comments, true);
                    
            Object.defineProperty(item, 'Finding Details', {enumerable: false, writable: true});

            if(!map.has( btoa(JSON.stringify( item )) )){
                    map.set( btoa(JSON.stringify( item )) );        
                    
                    dedup.push({
                        Title: item.Title.substr(0, 32760),
                        'SCAP Hosts': item['SCAP Hosts'].substr(0, 32760),
                        'CKL Hosts': item['CKL Hosts'].substr(0, 32760),
                        Vulnerability: item.Vulnerability.substr(0, 32760),
                        Version: item.Version,
                        Release: item.Release,
                        grpId: item.grpId,
                        vulnId: item.vulnId,
                        ruleId: item.ruleId,
                        'SCAP Status': item['SCAP Status'],
                        'CKL Status': item['CKL Status'],
                        'SCAP File' : item['SCAP File'],
                        'CKL File': item['CKL File'],
                        'Finding Details': item['Finding Details'].substr(0, 32760),
                        Comments: item.Comments.substr(0, 32760)
                    });
                }
            }
            
            issues.results = dedup;
            
            return issues;  
        },
        software(acasScans){
            const report = {};
            report.cols = [ {width:75}, {width:25}, {width:75}];
            report.title = "Windows Software"
            report.results = [];
            var software = [];
            acasScans.forEach( (acas) => {
                acas.hosts.forEach( (host) => {
                    host.requirements.filter( (f) => f.pluginId == 20811 ).forEach( (req) => {
                        req.comments.split("\n").filter(f => f.trim() !== '').filter( f => f.indexOf('The following updates are installed') == -1).slice(1).forEach( (install) => {
                            name = /(.*)\[version/ig.exec(install) ? /(.*)\[version/ig.exec(install)[1].trim() : '';
                            version = ( /\[version ([a-z0-9.]+)\]/ig.exec(install) ) ? /\[version ([a-z0-9.]+)\]/ig.exec(install)[1] : '';
                            installed = /\[installed on (.*)\]/ig.exec(install) ? /\[installed on (.*)\]/ig.exec(install)[1].trim() : '';

                            if( name && name.match(/driver|library|framework|patch|update|runtime|chipset|redistributable|kb[0-9]+/ig) == null ){
                                if( software.filter( f => f.name == name && f.version == version).length == 0){
                                    software.push( {
                                        version : version,
                                        name : name,
                                        hosts :[
                                            {
                                                installed : installed,
                                                hostname : host.hostname,
                                                ip : host.ip
                                            }
                                        ]
                                    } );    
                                }else{
                                    software.filter( f => f.name == name && f.version == version)[0].hosts.push({
                                        installed : installed,
                                        hostname : host.hostname,
                                        ip : host.ip
                                    })
                                }
                            }
                        })
                    })
                })
            })
            
            software.sort((a,b) => a.name.localeCompare(b.name)).forEach( (s) => {
                if(s.name.trim() !== ''){
                    report.results.push({
                        Name : s.name,
                        Version : s.version,
                        Hosts : s.hosts.map( (m) => { return m.hostname ? m.hostname : m.ip } ).join(',')
                    })
                }
            });
            return report;
        },
        packages(acasScans){
            const report = {};
            report.cols = [ {width:75}, {width:25}, {width:25}, {width:25}, {width:75}];
            report.title = "Linux Packages"
            report.results = [];
            var packages = [];
            acasScans.forEach( (acas) => {
                acas.hosts.forEach( (host) => {
                    host.requirements.filter( (f) => f.pluginId == 22869 ).forEach( (req) => {
                        req.comments.split("\n").filter(f => f.trim() !== '').filter( f => f.indexOf('list of packages installed') == -1).slice(1).forEach( (install) => {
                            try{
                                if( (install.match(/:/g) || []).length < 3 ){
                                    pkgRegex = /(.*)-(.*)-(.*)\.(.*_.*)\|(.*)/.exec(install.trim())
                                    if(pkgRegex == null){
                                        pkgRegex = /(.*)-(.*)-(.*)\.(.*)\|(.*)/.exec(install.trim())
                                    }
                                    if(pkgRegex == null){
                                        pkgRegex = /(.*)-(.*)-(.*)\|(.*)/.exec(install.trim())
                                    }
                                    if(pkgRegex == null){
                                        pkgRegex = /(.*)-(.*)\|(.*)/.exec(install.trim())
                                    }
                                
                                    if(pkgRegex && pkgRegex.length > 4){
                                        pkgInfo = {
                                            name    : pkgRegex[1],
                                            version : pkgRegex[2],
                                            release : pkgRegex[3],
                                            arch    : pkgRegex[4],
                                        }
                                        if( pkgInfo && pkgInfo.name && pkgInfo.name.match(/drv|driver|lib|library|framework|patch|update|runtime|chipset/ig) == null ){
                                            
                                            //first time software present
                                            if( packages.filter( f => f.name == pkgInfo.name && f.version == pkgInfo.version && f.release == pkgInfo.release && f.arch == pkgInfo.arch).length == 0){
                                                packages.push( {
                                                    version : pkgInfo.version.trim(),
                                                    release : pkgInfo.release.trim(),
                                                    arch    : pkgInfo.arch.trim(),
                                                    name    : pkgInfo.name.trim(),
                                                    hosts   : [
                                                        {
                                                            hostname    : host.hostname,
                                                            ip          : host.ip
                                                        }
                                                    ]
                                                } );    
                                            }else{
                                                //just add new host
                                                packages.filter( f => f.name == pkgInfo.name && f.version == pkgInfo.version && f.release == pkgInfo.release && f.arch == pkgInfo.arch)[0].hosts.push({
                                                    hostname    : host.hostname,
                                                    ip          : host.ip
                                                })
                                            }
                                        }
                                    }
                                }
                            }catch(err){
                                console.log(err)
                            }
                        })
                    })
                })
            })
            
            packages.sort((a,b) => a.name.localeCompare(b.name)).forEach( (s) => {
                if(s.name.trim() !== ''){
                    report.results.push({
                        Name : s.name,
                        Version : s.version,
                        Release : s.release,
                        Arch    : s.arch,
                        Hosts : s.hosts.map( (m) => { return m.hostname ? m.hostname : m.ip } ).join(',')
                    })
                }
            });
            return report;
        },
        scaninfo(scans){
            const report = {};
            report.cols = [ 
                {width:20}, {width:20}, {width:20}, {width:20}, {width:20},
                {width:20}, {width:20}, {width:20}, {width:20}, {width:20},
                {width:20}, {width:20}, {width:20}, {width:20}, {width:20},
                {width:20}, {width:20}, {width:20}, {width:20}, {width:20},
                {width:20}, {width:20}, {width:20}, {width:20}, {width:20},
                {width: 20}
            ];
            report.title = "Automated Scan Info"
            report.results = [];
            
            scans.acas.forEach( (acas) => {
                acas.hosts.forEach( (host) => {
                    host.requirements.filter( (f) => f.pluginId == 19506 ).forEach( (req) => {
                        const infoDetails = {}
                        infoDetails['Scan File'] = acas.scanFile;
                        req.comments.split("\n").filter(f => f.trim() !== '').filter( f => f.indexOf('Information about this scan') == -1).slice(1).forEach( (info) => {
                            if(info && info.trim() !== ''){     
                                if( info.split(':').length == 2){
                                    infoDetails[ info.split(':')[0].trim() ] = info.split(':')[1].trim()
                                }
                            }
                        })
                        if(infoDetails){
                            report.results.push( infoDetails )
                        }
                    })
                })
            })
            
            scans.scap.forEach( (scap) => {
                
                const infoDetails = {
                    'Scan File' : scap.scanFile,
                    'Plugin feed version' : 'V' + scap.version + 'R' + scap.release,
                    'Scanner edition used' : scap.scannerEdition,
                    'Scan Type' : 'Normal',
                    'Scan policy used' : scap.policy,
                    'Credentialed checks' : true,
                    'Scan Start Date' : scap.scanDate,
                    'Scan duration' : scap.duration + ' sec'
                }

                report.results.push( infoDetails )
            })
            
            return report;
        },
        ppsm(acas){
            const ppsm_rep = {};
            ppsm_rep.title = "PPSM";
            
            ppsm_rep.cols = [{ width: 25 }, { width: 25 }, { width: 25 }, { width: 25 }, { width: 25 }];
            ppsm_rep.results = [];
            
            var ports = [];
            acas.forEach( (a) => {
                a.hosts.forEach( (h) => {
                    h.requirements.filter( f => f.pluginId == 11219 ).map( (m) => { return { port: m.port, protocol: m.protocol, service: m.service}}).forEach( (p) => { 
                        if( ports.filter( f => f.port == p.port).length == 0){  ports.push(p) }
                    } )
                } )
            } )
            acas.forEach( (a) => {
                a.hosts.forEach( (h) => {
                    h.requirements.filter( f => f.pluginId == 14272 ).map( (m) => { return { port: m.port, protocol: m.protocol, service: m.service}}).forEach( (p) => { 
                        if( ports.filter( f => f.port == p.port).length == 0){  ports.push(p) }
                    } )
                } )
            } )

            ports.sort((a,b)=> a.port - b.port).forEach( (i) => { 
                ppsm_rep.results.push({
                    Ports : i.port,
                    Protocol : i.protocol,
                    Service : i.service.toUpperCase(),
                    Purpose : '',
                    'Used By' : '',
                })
            } );
            return ppsm_rep;
        },
        rmf(rmf){
