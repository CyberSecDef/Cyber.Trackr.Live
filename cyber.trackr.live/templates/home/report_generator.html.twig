{% extends 'base.html.twig' %}
{% block title %}Scans To Reports{% endblock %}
{% block og_title %}Scans → Reports — POAM and RAR generator{% endblock %}
{% block og_description %}Drop ACAS, SCAP, or CKL scan output and export an eMASS-ready POAM and RAR. No reconciliation, no Excel gymnastics. Browser-only — scan data stays local.{% endblock %}
{% block og_image_name %}ckl{% endblock %}

{% block body %}
    <section class="lib-page" aria-labelledby="rg-page-title">
        <div class="rule-text">&sect; Tools &middot; Scans &rsaquo; Reports</div>

        <header class="lib-page__header">
            <span class="eyebrow">Client-side report generator</span>
            <h1 id="rg-page-title" class="lib-page__title-large">
                Scans &rsaquo; <em>POAM &amp; RAR</em>
            </h1>
            <p class="lib-page__lede">
                Drop scan files in the box below. Everything parses in your browser &mdash; no data ever touches the server. Output is an eMASS-compatible XLSX. Treat the result as CUI.
            </p>
            <p class="lib-page__lede u-mt-0">
                Accepts <strong>.nessus</strong> (ACAS), <strong>.xml</strong> (SCAP XCCDF), <strong>.ckl</strong> / <strong>.cklb</strong> (STIG checklists).
            </p>
        </header>

        <div class="rule-text">&sect; I &middot; Report Details</div>

        <div class="rg-setup">
            <div class="rg-setup__col">
                <span class="eyebrow">Report data points</span>
                <div class="form-stack">
                    <div class="form-field">
                        <label for="inputCommand">Command</label>
                        <input type="text" id="inputCommand" placeholder="Command (NSWC DD)">
                    </div>
                    <div class="form-field">
                        <label for="inputContact">Contact</label>
                        <input type="text" id="inputContact" placeholder="John Doe">
                    </div>
                    <div class="form-field">
                        <label for="inputPhone">Phone</label>
                        <input type="text" id="inputPhone" placeholder="800-555-1212">
                    </div>
                    <div class="form-field">
                        <label for="inputEmail">Email</label>
                        <input type="text" id="inputEmail" placeholder="john.doe@acme.com">
                    </div>
                </div>
            </div>

            <div class="rg-setup__col">
                <span class="eyebrow">Render options</span>

                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" value="PreFillScd" id="inputPreFillScd" checked="checked">
                    <label class="form-check-label" for="inputPreFillScd">Prefill Scheduled Completion Date</label>
                </div>

                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" value="CondenseHostnames" id="inputCondenseHostnames" checked="checked">
                    <label class="form-check-label" for="inputCondenseHostnames">Condense Hostnames</label>
                </div>

                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" value="CondenseTestPlan" id="inputCondenseTestPlan">
                    <label class="form-check-label" for="inputCondenseTestPlan">Condense Test Plan</label>
                </div>

                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" value="LowerResidualRisk" id="inputLowerResidualRisk" checked="checked">
                    <label class="form-check-label" for="inputLowerResidualRisk">Lower Risk</label>
                </div>
            </div>

            <div class="rg-setup__col">
                <span class="eyebrow">Scan files</span>

                <div id="ScansAndOptionsBody">
                    <div id="drop-area" class="rg-drop-area">
                        <p class="rg-drop-area__text">
                            Drop scan files here, or pick them by hand.
                        </p>
                        <input type="file" id="fileElem" multiple="multiple" onchange="scansToPoam.actions.handleFiles(this.files)" style="display:none;">
                        <label class="cta-secondary" for="fileElem">
                            <i class="bi bi-upload" aria-hidden="true"></i>
                            Select scan files
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="rule-text">&sect; II &middot; Selected scan files</div>

        <div class="data-table-wrap">
            <table id="scanFiles" class="data-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Created</th>
                        <th>Size</th>
                        <th>File Type</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
            <div class="data-table-foot">
                <span id="parseStatus"></span>
                <button class="cta-primary" type="button" id="scans2poamParse" disabled="disabled">
                    Parse files
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <div class="rule-text">&sect; III &middot; Scan summary</div>

        <div class="data-table-wrap">
            <table id="scanSummary" class="data-table">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Hostname</th>
                        <th>IP</th>
                        <th>OS</th>
                        <th>Scan File Name</th>
                        <th>CAT I</th>
                        <th>CAT II</th>
                        <th>CAT III</th>
                        <th>CAT IV</th>
                        <th>Total</th>
                        <th>Score</th>
                        <th>Credentialed</th>
                    </tr>
                </thead>
            </table>
            <div class="data-table-foot">
                <span></span>
                <button class="cta-primary" type="button" id="scans2poamExecute">
                    Execute &amp; download XLSX
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <div id="result"></div>
        <div id="alertWindow" class="rg-alerts"></div>
    </section>

<script src="/js/jmespath.js" type="text/javascript"></script>
<script src="/js/moment-2.30.1.js" type="text/javascript"></script>
<script src="/js/zip.js" type="text/javascript"></script>
<script src="/js/inflate.js" type="text/javascript"></script>
<script src="/js/deflate.js" type="text/javascript"></script>
<script src="/js/xlsx.full.min.js" type="text/javascript"></script>

<script type="text/js-worker">
webWorker = {
    data : {},
    reports : {
        raw(scans, opts){            
            const raw = {};
            raw.title = "Raw Data";
            raw.cols = [{ width: 15 }, { width: 40 }, { width: 40 }, { width: 15 }, { width: 10 }, // a-e
                    { width: 10 }, { width: 15 }, { width: 15 }, { width: 30 }, { width: 25 }, // f-j
                    { width: 25 }, { width: 15 }, { width: 20 }, { width: 20 }, { width: 40 }, // k-o
                    { width: 10 }, { width: 15 }, { width: 30 }, { width: 30 }, { width: 30 }, // p-t
                    { width: 15 }, { width: 20 }, { width: 20 }, { width: 30 }, // u-x
                  ];
                  
            raw.results = [];
            
            scans.scap.forEach((scap) => {
                scap.requirements.forEach((req) => {
                    raw.results.push({
                        'Scan Type': scap.scanType.toUpperCase(),
                        'Scan Title': scap.title.replace('Security Technical Implementation Guide',''),
                        Filename: scap.scanFile,
                        'Scan Date': scap.scanDate,
                        Version: scap.version,
                        Release: scap.release,
                        Credentialed: scap.credentialed,
                        Hostname: scap.hostname && scap.hostname.trim() != '' ? scap.hostname : scap.ip,

                        grpId: req.grpId,
                        vulnId: req.vulnId,
                        ruleId: req.ruleId,
                        pluginId: req.pluginId,

                        'IA Controls': typeof req.iaControls === 'object' ? req.iaControls.join(', ').trim() : req.iaControls,
                        'RMF Controls' : opts.rmf_cci.filter( c => c.cci == ( req.cci !== null && typeof req.cci === 'object' ? req.cci.join(', ').trim() : req.cci ) ).map( m => m.control).join(','),
                        
                        CCI: req.cci !== null && typeof req.cci === 'object' ? req.cci.join(', ').trim() : req.cci,
                        Title: req.title,
                        Severity: req.severity,
                        Status: req.status,
                        'Finding Details': req.findingDetails.substr(0, 32760),

                        Description: req.description.substr(0, 32760),
                        Solution: req.solution.substr(0, 32760),
                        fixId: req.fixId,
                        References: req.references.substr(0, 32760),
                        Resources: req.resources,
                        Comments: req.comments.substr(0, 32760),
                    });
                });
            });

            scans.ckl.forEach((ckl) => {
                ckl.requirements.forEach((req) => {
                    raw.results.push({
                        'Scan Type': ckl.scanType.toUpperCase(),
                        'Scan Title': ckl.title.replace('Security Technical Implementation Guide',''),
                        Filename: ckl.scanFile,
                        'Scan Date': ckl.scanDate,
                        Version: ckl.version,
                        Release: ckl.release,
                        Credentialed: ckl.credentialed,
                        Hostname: ckl.hostname && ckl.hostname.trim() != '' ? ckl.hostname : ckl.ip,

                        grpId: req.grpId,
                        vulnId: req.vulnId,
                        ruleId: req.ruleId,
                        pluginId: req.pluginId,

                        'IA Controls': typeof req.iaControls === 'object' ? req.iaControls.join(', ').trim() : req.iaControls,
                        'RMF Controls' : opts.rmf_cci.filter( c => c.cci == ( req.cci !== null && typeof req.cci === 'object' ? req.cci.join(', ').trim() : req.cci ) ).map( m => m.control).join(',')  ,
                        CCI: req.cci !== null && typeof req.cci === 'object' ? req.cci.join(', ').trim() : req.cci,
                        Title: req.title,
                        Severity: req.severity,
                        Status: req.status,
                        'Finding Details': req.findingDetails.substr(0, 32760),

                        Description: req.description.substr(0, 32760),
                        Solution: req.solution.substr(0, 32760),
                        fixId: req.fixId,
                        References: req.references.substr(0, 32760),
                        Resources: req.resources,

                        Comments: req.comments.substr(0, 32760),
                    });
                });
            });
          
            scans.acas.forEach((acas) => {
                acas.hosts.forEach((host) => {
                    host.requirements.forEach((req) => {
                        raw.results.push({
                            'Scan Type': acas.scanType.toUpperCase(),
                            'Scan Title': 'Assured Compliance Assessment Solution',
                            Filename: acas.scanFile,

                            Release: '',
                            Credentialed: host.credentialed,
                            Hostname: host.hostname && host.hostname.trim() != '' ? host.hostname : host.ip,
                            Version: host.scanEngine,
                            'Scan Date': host.scanDate,

                            grpId: req.grpId,
                            vulnId: req.vulnId,
                            ruleId: req.ruleId,
                            pluginId: req.pluginId,

                            'IA Controls': typeof req.iaControls === 'object' ? req.iaControls.join(', ').trim() : req.iaControls,
                            'RMF Controls' : opts.rmf_cci.filter( c => c.cci == ( req.cci !== null && typeof req.cci === 'object' ? req.cci.join(', ').trim() : req.cci ) ).map( m => m.control).join(','),
                            CCI: req.cci !== null && typeof req.cci === 'object' ? req.cci.join(', ').trim() : req.cci,
                            Title: req.title,
                            Severity: req.severity,
                            Status: req.status,
                            'Finding Details': req.findingDetails.substr(0, 32760),

                            Description: req.description.substr(0, 32760),
                            Solution: req.solution.substr(0, 32760),
                            fixId: req.fixId,
                            References: req.references.substr(0, 32760),
                            Resources: req.resources,
                            Comments: req.comments.substr(0, 32760),
                        });
                    });
                });
            });

            return raw;
        },
        summary(scans){
            const summary = {};
            summary.title = "Summary";
            summary.cols = [{ width: 10 }, { width: 20 }, { width: 20 }, { width: 50 }, { width: 50 },
                            { width: 10 }, { width: 10 }, { width: 10 }, { width: 10 }, { width: 10 },
                            { width: 10 }, { width: 25 }];
            summary.results = [];
            scans.acas.forEach((scanItem) => {
                scanItem.hosts.forEach((hostItem) => {
                    summary.results.push({
                        Type: 'ACAS',
                        Hostname: typeof hostItem.hostname === 'object' ? hostItem.hostname[0] : hostItem.hostname,
                        IP: hostItem.ip,
                        OS: hostItem.os,
                        'Scan File Name': scanItem.scanFile,
                        'CAT I': hostItem.openFindings.cat1,
                        'CAT II': hostItem.openFindings.cat2,
                        'CAT III': hostItem.openFindings.cat3,
                        'CAT IV': hostItem.openFindings.cat4,
                        Total: 1*hostItem.openFindings.cat1 +
                            1*hostItem.openFindings.cat2 +
                            1*hostItem.openFindings.cat3 +
                            1*hostItem.openFindings.cat4,
                        Score: 10 * hostItem.openFindings.cat1 +
                            3*hostItem.openFindings.cat2 +
                            1*hostItem.openFindings.cat3,
                        Credentialed: hostItem.credentialed,
                    });
                });
            });
                
            scans.scap.forEach((scanItem) => {
                summary.results.push({
                    Type: 'SCAP',
                    Hostname: typeof scanItem.hostname === 'object' ? scanItem.hostname[0] : scanItem.hostname,
                    IP: scanItem.ip,
                    OS: scanItem.os,
                    'Scan File Name': scanItem.scanFile,
                    'CAT I': scanItem.openFindings.cat1,
                    'CAT II': scanItem.openFindings.cat2,
                    'CAT III': scanItem.openFindings.cat3,
                    'CAT IV': 0,
                    Total : 1*scanItem.openFindings.cat1 +
                        1*scanItem.openFindings.cat2 +
                        1*scanItem.openFindings.cat3,
                    Score : 10 * scanItem.openFindings.cat1 +
                        3*scanItem.openFindings.cat2 +
                        1*scanItem.openFindings.cat3,
                    Credentialed: scanItem.credentialed,
                });
            });
                
            scans.ckl.forEach((scanItem) => {
                summary.results.push({
                    Type: 'CKL',
                    Hostname: typeof scanItem.hostname === 'object' ? scanItem.hostname[0] : scanItem.hostname,
                    IP: scanItem.ip,
                    OS: '',
                    'Scan File Name': scanItem.scanFile,
                    'CAT I': scanItem.openFindings.cat1,
                    'CAT II': scanItem.openFindings.cat2,
                    'CAT III': scanItem.openFindings.cat3,
                    'CAT IV': 0,
                    Total: 1*scanItem.openFindings.cat1 +
                        1*scanItem.openFindings.cat2 +
                        1*scanItem.openFindings.cat3,
                    Score: 10 * scanItem.openFindings.cat1 +
                        3*scanItem.openFindings.cat2 +
                        1*scanItem.openFindings.cat3,
                    Credentialed: scanItem.credentialed,
                });
            });
                
            summary.results.sort((a, b) => { return (a.Type.toLowerCase() > b.Type.toLowerCase() ? 1 : b.Type.toLowerCase() > a.Type.toLowerCase() ? -1 : ( a.Hostname.toLowerCase() > b.Hostname.toLowerCase() ? 1 : -1 )  )});
                
            return summary
        },
        patches(acas){
            const report = {};
            report.title = 'Missing Patches'
            report.cols = [ { width: 35 }, {width:50}, { width: 50 }];
            report.results = [];

            results = [];
            var myRegexp = /\+ Action to take : (.+)+/ig;
            acas.forEach( (a) => {
                a.hosts.forEach( (h) => {
                    myString = (h.requirements.filter( f => f.pluginId == 66334 ).map( m => m.comments )[0] + "")
                    var match = myRegexp.exec( myString );
                    while (match != null) {
                        results.push({
                            Host : ( h.hostname.trim() != '' ? h.hostname : h.ip),
                            OS: h.os,
                            Action : match[1]
                        })
                      match = myRegexp.exec(myString);
                    }        
                } )
            } )
            var myRegexp = /- (.+)+/ig;
            acas.forEach( (a) => {
                a.hosts.forEach( (h) => {
                    myString = (h.requirements.filter( f => f.pluginId == 66334 ).map( m => m.comments )[0] + "")
                    var match = myRegexp.exec( myString );
                    while (match != null) {
                        results.push({
                            Host : ( h.hostname.trim() != '' ? h.hostname : h.ip),
                            OS: h.os,
                            Action : match[1]
                        })
                      match = myRegexp.exec(myString);
                    }        
                } )
            } )

            results.sort((a,b) => a.Host.localeCompare(b.Host)).forEach( (f) => {
                report.results.push({
                    'Host' : f.Host,
                    'Operating System' : f.OS,
                    'Action' : f.Action
                })
            })
            
            return report;
        },
        acasUniqueIava(acas){
            const report = {};
            report.title = 'ACAS Unique IAVA'
            report.cols = [ { width: 25 }, {width:25}, { width: 50 }, { width: 25 }, { width: 25 }, { width: 25 }];
            report.results = [];
            
            plugins = [];
            acas.forEach( (a) => { a.hosts.forEach( (h) => { h.requirements.forEach( (r) => { 
                if(r.iava.trim() != '' && plugins.filter( obj => obj.pluginId == r.pluginId).length == 0){ plugins.push(r);  }
            } ) } ) } )

            plugins.map( (p) => p.pluginId).sort( (a,b) => ( a*1 - b*1 )).forEach( (pluginId) => {
                report.results.push({
                    'Plugin' : pluginId,
                    'IAVM' : plugins.find( (p) => p.pluginId == pluginId).iava,
                    'Plugin Name' : plugins.find( (p) => p.pluginId == pluginId).title,
                    'Family' : plugins.find( (p) => p.pluginId == pluginId).grpId,
                    'Severity' : ['Info','Low','Medium','High','Critical'][ plugins.find( (p) => p.pluginId == pluginId).severity ],
                    'Total' : acas.filter( (r) => ( r.hosts.length > 0 && r.hosts.filter( (f) => f.requirements.filter( (i) => i.pluginId == pluginId ).length > 0  ).length > 0  ) ).map( (r) => ( r.hosts ) ).reduce((a,b)=> a.concat(b), []).map( (h) => (h.hostname ? h.hostname : h.ip) ).length
                    
                })
            })
            return report;
        },
        acasUniqueVuln(acas){
            const report = {};
            report.title = 'ACAS Unique Vuln'
            report.cols = [ { width: 25 }, { width: 50 }, { width: 25 }, { width: 25 }, { width: 25 }];
            report.results = [];
            
            plugins = [];
            acas.forEach( (a) => { a.hosts.forEach( (h) => { h.requirements.forEach( (r) => { 
                if(plugins.filter( obj => obj.pluginId == r.pluginId).length == 0){ plugins.push(r);  }
            } ) } ) } )

            plugins.map( (p) => p.pluginId).sort( (a,b) => ( a*1 - b*1 )).forEach( (pluginId) => {
                report.results.push({
                    'Plugin' : pluginId,
                    'Plugin Name' : plugins.find( (p) => p.pluginId == pluginId).title,
                    'Family' : plugins.find( (p) => p.pluginId == pluginId).grpId,
                    'Severity' : ['Info','Low','Medium','High','Critical'][ plugins.find( (p) => p.pluginId == pluginId).severity ],
                    'Total' : acas.filter( (r) => ( r.hosts.length > 0 && r.hosts.filter( (f) => f.requirements.filter( (i) => i.pluginId == pluginId ).length > 0  ).length > 0  ) ).map( (r) => ( r.hosts ) ).reduce((a,b)=> a.concat(b), []).map( (h) => (h.hostname ? h.hostname : h.ip) ).length
                    
                })
            })
            return report;
        },
        operatingSystems(acas){
            const report = {};
            report.title = 'Operating Systems'
            report.cols = [ { width: 50 }, {width:25}, { width: 25 }];
            report.results = [];

            let counts = {}
            acas.map( (a) => { return a.hosts.map(m=>m.os) }).reduce((acc, val) => acc.concat(val), []).forEach( (f) => { counts[f] = counts[f] ? counts[f]+1 : 1 })                

            Object.keys(counts).sort().forEach( (f) => {
                report.results.push({
                    'Operating System' : f.trim() !== '' ? f : 'Unknown',
                    Count : counts[f],
                    'Detection Method' : 'Active',
                })
            })
            
            return report;
        },
        localUsers(acas){
            const report = {};
            report.title = 'Local Users'
            report.cols = [ { width: 50 }, {width:50}, { width: 50 }];
            report.results = [];

            var results = [];
            var myRegexp = /- ([a-zA-Z0-9]+)+/ig;
            acas.forEach( (a) => {
                a.hosts.forEach( (h) => {
                    h.requirements.filter( f => f.pluginId == 10860 ).map( m => m.comments ).forEach( (c) => {
                        var match = myRegexp.exec( c );
                        while (match != null) {
                            results.push({
                                Host : ( h.hostname.trim() != '' ? h.hostname : h.ip),
                                OS: h.os,
                                User : match[1]
                            })
                          match = myRegexp.exec(c);
                        }
                    } )
                } )
            } )
            
            var myRegexp = /User\s+:\s+([a-zA-Z0-9]+)+/ig;
            acas.forEach( (a) => {
                a.hosts.forEach( (h) => {
                    h.requirements.filter( f => f.pluginId == 95928 ).map( m => m.comments ).forEach( (c) => {
                        var match = myRegexp.exec( c );
                        while (match != null) {
                            results.push({
                                Host : ( h.hostname.trim() != '' ? h.hostname : h.ip),
                                OS: h.os,
                                User : match[1]
                            })
                          match = myRegexp.exec(c);
                        }
                    } )
                } )
            } )
            
            
            report.results = results.sort((a,b) => a.Host.localeCompare(b.Host));
            return report;
        },
        issues(scans){
          const issues = {};
            issues.title = 'Issues';
            issues.cols = [ { width: 50 }, { width: 25 }, { width: 25 }, { width: 75 }, { width: 10 }, 
                            { width: 10 }, { width: 35 }, { width: 35 }, { width: 35 }, { width: 15 }, 
                            { width: 15 }, { width: 75 }, { width: 75 }, { width: 50 }, { width: 50 }
                        ];
            results = [];
            
            //loop through all parsed scaps
            scans.scap.forEach((scap) => {
                //for each scap, loop through each scap requirement that is not closed
                scap.requirements.filter(s => s.status !== 'Completed').forEach((r) => {
                    //see if there are any matching stig requirements
                    if (scans.ckl.filter(stig => 
                        stig.id.replace(/ /ig, '_').replace(/STIG/ig, '').replace(/Security_Technical_Implementation_Guide/ig, '').replace(/xccdf_mil\.disa/ig, '').replace(/benchmark/ig, '').replace(/ /ig, '_').replace(/__/ig, '_').replace(/\./ig, '').replace(/_$/ig, '').replace(/^_/ig, '').toLowerCase() === 
                        scap.id.replace(/ /ig, '_').replace(/STIG/ig, '').replace(/Security_Technical_Implementation_Guide/ig, '').replace(/xccdf_mil\.disa/ig, '').replace(/benchmark/ig, '').replace(/ /ig, '_').replace(/__/ig, '_').replace(/\./ig, '').replace(/_$/ig, '').replace(/^_/ig, '').toLowerCase()).length > 0) {
                            //for each matching STIG.....
                            scans.ckl.filter(stig =>
                                stig.id.replace(/ /ig, '_').replace(/STIG/ig, '').replace(/Security_Technical_Implementation_Guide/ig, '').replace(/xccdf_mil\.disa/ig, '').replace(/benchmark/ig, '').replace(/ /ig, '_').replace(/__/ig, '_').replace(/\./ig, '').replace(/_$/ig, '').replace(/^_/ig, '').toLowerCase() === 
                                scap.id.replace(/ /ig, '_').replace(/STIG/ig, '').replace(/Security_Technical_Implementation_Guide/ig, '').replace(/xccdf_mil\.disa/ig, '').replace(/benchmark/ig, '').replace(/ /ig, '_').replace(/__/ig, '_').replace(/\./ig, '').replace(/_$/ig, '').replace(/^_/ig, '').toLowerCase()                   
                            ).forEach((c) => {
                                
                                //find the applicable stig requirement
                                if (r.status !== c.requirements.filter(cr => cr.vulnId.replace(/xccdf_mil.disa\.stig_group_/ig,'') === r.vulnId.replace(/xccdf_mil.disa\.stig_group_/ig,'') ).map(cr => cr.status).join()  ){
                                    
                                        results.push({
                                            Title: scap.title.replace('Security Technical Implementation Guide','STIG'),
                                            'SCAP Hosts': scans.scap.filter(s => s.id === scap.id && s.requirements.filter(srf => srf.status !== 'Completed').length > 0)
                                                .map(h => h.hostname)
                                                .sort()
                                                .filter((el, i, a) => { if (i === a.indexOf(el)) return 1; return 0; })
                                                .join(', '),
                                            'CKL Hosts': c.hostname,
                                            Vulnerability: r.title,
                                            Version: scap.version,
                                            Release: scap.release,
                                            grpId: r.grpId,
                                            vulnId: r.vulnId,
                                            ruleId: r.ruleId,
                                            'SCAP Status': r.status,
                                            'CKL Status': c.requirements
                                                .filter(cr => cr.vulnId.replace(/xccdf_mil.disa\.stig_group_/ig,'') === r.vulnId.replace(/xccdf_mil.disa\.stig_group_/ig,'') )
                                                .map(cr => cr.status).join(),
                                            'Finding Details': r.findingDetails.substr(0, 32760),
                                            'SCAP File': scap.scanFile,
                                            'CKL File': c.scanFile,
                                            Comments: c.requirements
                                                .filter(cr => cr.vulnId.replace(/xccdf_mil.disa\.stig_group_/ig,'') === r.vulnId.replace(/xccdf_mil.disa\.stig_group_/ig,''))
                                                .map(cr => cr.comments)
                                                .join(', ')
                                                .substr(0, 32760),
                                        });
                                    
                                }
                            });
                    } else {
                        results.push({
                            Title: scap.title.replace('Security Technical Implementation Guide','STIG'),
                            'SCAP Hosts': scans.scap.filter(s => s.id === scap.id && s.requirements.filter(srf => srf.status !== 'Completed').length > 0)
                                .map(h => h.hostname)
                                .sort()
                                .filter((el, i, a) => { if (i === a.indexOf(el)) return 1; return 0; })
