        });
        dropArea.addEventListener('drop', scansToPoam.actions.handleDrop, false);
        
        scansToPoam.backWorker = new Worker(window.URL.createObjectURL(scansToPoam.frontWorker.blob));
    },
    // Load the reference data once (a promise shared by every caller). Starts
    // as soon as files are added, so it downloads while the user parses;
    // execute() waits for it. A failed load can be retried.
    loadReferenceData(){
        if (!scansToPoam.referenceData) {
            scansToPoam.referenceData = new Promise((resolve, reject) => {
                const script = document.createElement('script');
                script.src = '/js/report-generator-data.js?v={{ app_version }}';
                script.onload = () => {
                    const data = window.scansToPoamData;
                    if (!data) { reject(new Error('reference data script loaded but defined nothing')); return; }
                    ['rmf_cia', 'rmf_cci', 'ap_mapping', 'rmf', 'acas_control'].forEach((k) => { scansToPoam[k] = data[k]; });
                    resolve();
                };
                script.onerror = () => reject(new Error('could not load /js/report-generator-data.js'));
                document.head.appendChild(script);
            }).catch((e) => { scansToPoam.referenceData = null; throw e; });
        }
        return scansToPoam.referenceData;
    },
    async execute(){
        try{
            await scansToPoam.loadReferenceData();
        }catch(e){
            console.log(e);
            $('#alertWindow').append( $('<p></p>').text("Could not load the report reference data. Check your connection and try Execute again.") );
            return;
        }
        try{
            scansToPoam.result = new Array();
            const filename = `scans2poam_${moment().format('YYYYMMDD_HHmmss')}.xlsx`
            let wb = XLSX.utils.book_new();
            
            const data = {};
            console.log('Generating Reports');
            try{
                console.log('Spawning thread to generate CCI data objects')
                data.cci                = await scansToPoam.frontWorker.asyncThread('reports.cci')
                console.log('Spawning thread to generate RMF data objects')
                data.rmf                = await scansToPoam.frontWorker.asyncThread('reports.rmf')            
                console.log('Spawning thread to generate acasUniqueVuln data objects')
                data.acasUniqueVuln     = await scansToPoam.frontWorker.asyncThread('reports.acasUniqueVuln', scansToPoam.scans.acas)
                console.log('Spawning thread to generate acasUniqueIava data objects')
                data.acasUniqueIava     = await scansToPoam.frontWorker.asyncThread('reports.acasUniqueIava', scansToPoam.scans.acas)
                console.log('Spawning thread to generate localUsers data objects')
                data.localUsers         = await scansToPoam.frontWorker.asyncThread('reports.localUsers', scansToPoam.scans.acas)
                console.log('Spawning thread to generate operatingSystems data objects')
                data.operatingSystems   = await scansToPoam.frontWorker.asyncThread('reports.operatingSystems', scansToPoam.scans.acas)
                console.log('Spawning thread to generate Missing Patches data objects')
                data.patches            = await scansToPoam.frontWorker.asyncThread('reports.patches', scansToPoam.scans.acas)
                console.log('Spawning thread to generate PPSM data objects')
                data.ppsm               = await scansToPoam.frontWorker.asyncThread('reports.ppsm', scansToPoam.scans.acas)
                console.log('Spawning thread to generate Windows Software list data objects')
                data.software           = await scansToPoam.frontWorker.asyncThread('reports.software', scansToPoam.scans.acas)
                console.log('Spawning thread to generate Linux Packages data objects')
                data.packages           = await scansToPoam.frontWorker.asyncThread('reports.packages', scansToPoam.scans.acas)
                console.log('Spawning thread to generate scanInfo data objects')
                data.scaninfo           = await scansToPoam.frontWorker.asyncThread('reports.scaninfo', scansToPoam.scans)
                console.log('Spawning thread to generate SCAP/CKL Issues data objects')
                data.issues             = await scansToPoam.frontWorker.asyncThread('reports.issues', scansToPoam.scans)
                
                if( Object.keys(scansToPoam.scans).map( k => scansToPoam.scans[k] ).reduce((acc, val) => acc.concat(val), []).length < 250){
                    console.log('Spawning thread to generate RAW data objects')
                    data.raw                = await scansToPoam.frontWorker.asyncThread('reports.raw', scansToPoam.scans)
                }else{
                    console.log('Too many scans to produce raw report');
                }
                
                console.log('Spawning thread to generate Summary data objects')
                data.summary            = await scansToPoam.frontWorker.asyncThread('reports.summary', scansToPoam.scans)
                console.log('Background threads completed')
                
                console.log('Spawning foreground thread to generate RAR data objects')
                data.rar = scansToPoam.io.report.rar();
                console.log('Spawning foreground thread to generate POAM v5.2 data objects')
                data.poam = scansToPoam.io.report.poam();
                
                console.log('Spawning foreground thread to generate POAM v5.6 data objects')
                data.poam56 = scansToPoam.io.report.poam56();
                console.log('Spawning foreground thread to generate Test Plan data objects')
                data.testPlan = scansToPoam.io.report.testPlan();    
            }catch(e){
                console.log(e);
                $('#alertWindow').append( $('<p></p>').text("Could not create all tabs") );
            }
            
            console.log('All Data Objects Generated')
            
            try{
                Object.keys(data).forEach((item) => {
                    console.log('Validating ' + item)
                    if(data[item] && data[item].results){
                        data[item].results.forEach((entry) => {
                            Object.keys(entry).forEach((field) => {
                                if (entry[field] && typeof entry[field] !== 'undefined' && entry[field].length > 32760) {
                                    entry[field] = entry[field].substr(0, 32760);
                                }
                            });
                        });
                    }
                });
            }catch(e){
                console.log(e);
                $('#alertWindow').append( $('<p></p>').text("Could not validate resulting XLS Spreadsheet") );
            }

            Object.keys(data).forEach((k) => {
                if(data && data[k] && data[k].results && data[k].results.length > 0){
                    try{
                        console.log('Generating ' + k + ' tab')
                        const ws = XLSX.utils.json_to_sheet(data[k].results);
                        ws['!cols'] = data[k].cols;
                        ws['!autofilter'] = { ref: `A1:${String.fromCharCode(64 + data[k].cols.length)}1` };
                        XLSX.utils.book_append_sheet(wb, ws, data[k].title);
                    }catch(e){
                        console.log(e);
                        $('#alertWindow').append( $('<p></p>').text("Error exporting " + k + " tab") );
                    }
                }
            });
            
            XLSX.writeFile(wb, filename, {compression: true});
            wb = null;

        }catch(e){
            console.log(e)
            $('#alertWindow').append( $('<p></p>').text("Error exporting XLSX Spreadsheet") );
        }
            
    },
    async parse(){
        //only execute if all the files have been ingested
        if( $("table#scanFiles tbody tr td:nth-child(6):not(:contains('Pending')) ").length == 0){
          scansToPoam.parsing = true;
          scansToPoam.actions.refreshParseButton();
          try {
            //reset incase the same scans are run twice
            scansToPoam.scans = { scap : [], ckl : [], acas : [] }
            
            const l = scansToPoam.fileArray.length;
            for( let i = 0; i < l; i++){
                console.log( (i+1) + ' / ' + l + ' Ingested file ' + scansToPoam.fileArray[i].name);
                await scansToPoam.io.parse.File(scansToPoam.fileArray[i]);
                scansToPoam.fileArray[i].data = '';
                $('table tr#' + scansToPoam.fileArray[i].fileId + ' td:nth-child(6)').text('Completed');
            }
        
            var res = [];

            for(let scan of scansToPoam.scans.acas){
                console.log('Parsing ACAS scan ' + scan.scanFile);
                for(let host of scan.hosts){
                    res.push({
                        Type : scan.scanType,
                        Hostname : host.hostname,
                        IP : host.ip,
                        OS : host.os,
                        'Scan File Name' : scan.scanFile,
                        'CAT I' : host.requirements.filter( f => f.severity >= 3).length,
                        'CAT II' : host.requirements.filter( f => f.severity == 2).length,  
                        'CAT III' : host.requirements.filter( f => f.severity == 1 ).length,
                        'CAT IV' : host.requirements.filter( f => f.severity == 0).length,
                        Total : host.requirements.length,
                        Score : 10 * host.requirements.filter( f => f.severity >= 3).length + 3 * host.requirements.filter( f => f.severity == 2).length + 1 * host.requirements.filter( f => f.severity == 1).length,
                        Credentialed : host.credentialed
                    })
                }
            }

            for(let scan of scansToPoam.scans.ckl){
                console.log('Parsing CKL scan ' + scan.scanFile);
                res.push({
                    Type : scan.scanType,
                    Hostname : scan.hostname,
                    IP : scan.ip,
                    OS : '',
                    'Scan File Name' : scan.scanFile,
                    'CAT I' : scan.openFindings.cat1,
                    'CAT II' : scan.openFindings.cat2,
                    'CAT III' : scan.openFindings.cat3,
                    'CAT IV' : 0,
                    Total : 1 * scan.openFindings.cat1 + 1 * scan.openFindings.cat2 + 1 * scan.openFindings.cat3,
                    Score : 10 * scan.openFindings.cat1 + 3 * scan.openFindings.cat2 + 1 * scan.openFindings.cat3,
                    Credentialed : scan.credentialed
                })
            }

            for(let scan of scansToPoam.scans.scap){
                console.log('Parsing SCAP scan ' + scan.scanFile);
                res.push({
                    Type : scan.scanType,
                    Hostname : scan.hostname,
                    IP : scan.ip,
                    OS : '',
                    'Scan File Name' : scan.scanFile,
                    'CAT I' : scan.openFindings.cat1,
                    'CAT II' : scan.openFindings.cat2,
                    'CAT III' : scan.openFindings.cat3,
                    'CAT IV' : 0,
                    Total : 1 * scan.openFindings.cat1 + 1 * scan.openFindings.cat2 + 1 * scan.openFindings.cat3,
                    Score : 10 * scan.openFindings.cat1 + 3 * scan.openFindings.cat2 + 1 * scan.openFindings.cat3,
                    Credentialed : scan.credentialed
                })
            }

            console.log('Finished parsing all scan files');
            
            var oTblReport = $("#scanSummary")
            console.log('Updating Summary Table on Cyber Trackr');
            if ( ! $.fn.DataTable.isDataTable( '#scanSummary' ) ) {
                oTblReport.DataTable ({
                    "data" : res,
                    pageLength : 25,
                    // Cells come from uploaded files (HOST_NAME, HOST_IP, file name, OS);
                    // render them as text so a crafted scan can't inject markup (S4).
                    columnDefs : [ { targets : '_all', render : $.fn.dataTable.render.text() } ],
                    "columns" : [
                        { "data" : "Type" },
                        { "data" : "Hostname" },
                        { "data" : "IP" },
                        { "data" : "OS" },
                        { "data" : "Scan File Name" },
                        { "data" : "CAT I" },
                        { "data" : "CAT II" },
                        { "data" : "CAT III" },
                        { "data" : "CAT IV" },
                        { "data" : "Total" },
                        { "data" : "Score" },
                        { "data" : "Credentialed" }
                    ]
                });
            }else{
                oTblReport.DataTable().clear();
                oTblReport.DataTable().rows.add(res);
                oTblReport.DataTable().draw();
            }
          } finally {
            scansToPoam.parsing = false;
            scansToPoam.actions.refreshParseButton();
          }
        }
    },
    utils : {
        uuidv4() {
            return ([1e7]+-1e3+-4e3+-8e3+-1e11).replace(/[018]/g, c =>
                (c ^ crypto.getRandomValues(new Uint8Array(1))[0] & 15 >> c / 4).toString(16)
            )
        },  
        riskVal(source, format) {
            if(source !== null && format){
                const crossWalkFrom = {
                    VL: 0, L: 1, M: 2, H: 3, VH: 4, 
                    NONE: 0, LOW: 1, MEDIUM: 2, HIGH: 3, CRITICAL: 4, INFO: 0, 'VERY HIGH' : 4,
                    CATIV: 0, CATIII: 1, CATII: 2, CATI: 3, 
                    'IV': 0, 'III': 1, 'II': 2, 'I': 3, 
                    'CAT IV': 0, 'CAT III': 1, 'CAT II': 2, 'CAT I': 3, 
                    MODERATE: 2, 0: 0, 1: 1, 2: 2, 3: 3, 4: 4,
                };
                const crossWalkTo = {
                    'VL-VH': {
                        0: 'VL', 1: 'L', 2: 'M', 3: 'H', 4: 'VH',
                    },
                    'VL VH': {
                        0: 'Very Low', 1: 'Low', 2: 'Medium', 3: 'High', 4: 'Very High',
                    },
                    'POAM': {
                        0: 'Very Low', 1: 'Low', 2: 'Moderate', 3: 'High', 4: 'Very High',
                    },
                    'N-C': {
                        0: 'None', 1: 'Low', 2: 'Medium', 3: 'High', 4: 'Critical',
                    },
                    CAT: {
                        0: 'CAT IV', 1: 'CAT III', 2: 'CAT II', 3: 'CAT I', 4: 'CAT I',
                    },
                    MIN: {
                        0: 'IV', 1: 'III', 2: 'II', 3: 'I', 4: 'I',
                    },
                    NUM:{
                        0: 0, 1: 1, 2: 2, 3: 3, 4: 4,
                    },
                };

                return crossWalkTo[format][crossWalkFrom[`${source}`.toUpperCase().trim()]];
            }else{
                return "UNK";
            }
        },      
        scd(r){
            return {
                'I'     : moment().add(1, 'months').format('MM/DD/YYYY'),
                'II'    : moment().add(3, 'months').format('MM/DD/YYYY'),
                'III'   : moment().add(12, 'months').format('MM/DD/YYYY'),
                'IV'    : moment().add(36, 'months').format('MM/DD/YYYY'),
            }[ scansToPoam.utils.riskVal(r, 'MIN') ]
        },
        milestone(r){
            return {
                'I'     : ['Winter', 'Spring', 'Summer', 'Autumn'][Math.floor(( moment().add(1, 'months').format('MM') / 12 * 4)) % 4]  + ' ' + moment().add(1, 'months').format('YYYY')  + ' Updates ' + moment().add(1, 'months').format('MM/DD/YYYY'),
                'II'    : ['Winter', 'Spring', 'Summer', 'Autumn'][Math.floor(( moment().add(3, 'months').format('MM') / 12 * 4)) % 4]  + ' ' + moment().add(3, 'months').format('YYYY')  + ' Updates ' + moment().add(3, 'months').format('MM/DD/YYYY'),
                'III'   : ['Winter', 'Spring', 'Summer', 'Autumn'][Math.floor(( moment().add(12, 'months').format('MM') / 12 * 4)) % 4] + ' ' + moment().add(12, 'months').format('YYYY') + ' Updates ' + moment().add(12, 'months').format('MM/DD/YYYY'),
                'IV'    : ['Winter', 'Spring', 'Summer', 'Autumn'][Math.floor(( moment().add(36, 'months').format('MM') / 12 * 4)) % 4] + ' ' + moment().add(36, 'months').format('YYYY') + ' Updates ' + moment().add(36, 'months').format('MM/DD/YYYY'),
            }[ scansToPoam.utils.riskVal(r, 'MIN') ]
        },
    },
    actions : {
        highlight(e) {
            scansToPoam.dropArea.classList.add('bg-light')
        },  
        unhighlight(e) {
            scansToPoam.dropArea.classList.remove('bg-light')
        },
        
        handleDrop(e) {
            var dt = e.dataTransfer
            var files = dt.files
            scansToPoam.actions.handleFiles(files)
        },
        handleFiles(files) {
            files = [...files]
            scansToPoam.loadReferenceData().catch(() => {}); // start early; execute() reports failures
            scansToPoam.readsInFlight += files.length;
            scansToPoam.actions.refreshParseButton();
            files.forEach(scansToPoam.io.preview);
        },
        // Parse is clickable only when a click will parse: no file still being
        // read, no parse running, and every listed file "Pending" (the same
        // condition parse() checks). Before, the button was enabled once and
        // never disabled, so a second batch could be parsed mid-read, and a
        // click after a parse silently did nothing.
        refreshParseButton() {
            const status = $('table#scanFiles tbody tr td:nth-child(6)');
            const ready = scansToPoam.readsInFlight === 0
                && !scansToPoam.parsing
                && status.length > 0
                && status.filter(":not(:contains('Pending'))").length === 0;
            $('#scans2poamParse').prop('disabled', !ready);
        },
        preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        },
    },
    io: {
        preview(file){
            
            var re = /(?:\.([^.]+))?$/;
            var fileId = 'file' + scansToPoam.utils.uuidv4();
            let row = $('<tr></tr>').attr('id', fileId);
            
            row.append( 
                $('<td></td>').text( $('table#scanFiles tbody tr').length + 1 ) 
            );
            
            row.append(
                $('<td></td>').append(
                    $('<span></span>').text('[X]').css({ 'font-weight': 'bold', 'color' : 'red'}).click(function(){
                        $("tr#" + fileId).remove(); 
                        $('table#scanFiles tbody tr').each((index,item)=>{ $(item).find("td:nth-child(1)").text(index+1)});
                        
                        for (var i = scansToPoam.fileArray.length - 1; i >= 0; --i) {
                            if (scansToPoam.fileArray[i].fileId == fileId) {
                                scansToPoam.fileArray.splice(i,1);
                            }
                        }
                        scansToPoam.actions.refreshParseButton();
                    })
                ).append(
                    $('<span></span>').text('   ')
                ).append(
                    $('<span></span>').text(file.name) 
                )
            );
            row.append( $('<td></td>').text( new Date( file.lastModified ).toUTCString() ) );
            row.append( $('<td></td>').text(file.size) );
            row.append( $('<td></td>').text( re.exec(file.name)[1] ) );
            row.append( $('<td></td>').text(' ') );
            $('table#scanFiles tbody').append(row);

            
            return new Promise((resolve, reject) => {
                let reader = new FileReader()
                reader.readAsDataURL(file)
            
                reader.onloadend = () => {
                    scansToPoam.readsInFlight--;
                    const row = $('table#scanFiles tbody tr#' + fileId);
                    if (row.length === 0) {
                        // Removed with [X] while it was still being read: don't queue it.
                    } else if (reader.result === null) {
                        // Unreadable (e.g. permissions): drop it rather than crash parse().
                        row.remove();
                        $('table#scanFiles tbody tr').each((index,item)=>{ $(item).find("td:nth-child(1)").text(index+1)});
                        $('#alertWindow').append( $('<p></p>').text("Could not read " + file.name + "; it was removed from the list.") );
                    } else {
                        file.data = reader.result;
                        file.fileId = fileId;
                        row.find('td:nth-child(6)').text('Pending')
                        file.parsed = false;
                        scansToPoam.fileArray.push(file);
                    }
                    scansToPoam.actions.refreshParseButton();
                    resolve(reader.result )
                }
                
            });
            
  
        },
        parse : {
            async File(file){
                return new Promise((resolve, reject) => {
                    try{
                        var re = /(?:\.([^.]+))?$/;
                        switch (re.exec(file.name)[1].toLowerCase()) {
                            case 'ckl':
                                scansToPoam.io.parse.Ckl(file);
                                resolve()
                                break;
                            case 'cklb':
                                scansToPoam.io.parse.Cklb(file);
                                resolve()
                                break;
                            case 'nessus':
                                scansToPoam.io.parse.Nessus(file);
                                resolve()
                                break;
                            case 'xml':
                                scansToPoam.io.parse.Xccdf(file);
                                resolve()
                                break;
                            case 'xls':
                            case 'xlsx':
                            case 'xlsm':
                                scansToPoam.io.parse.Excel(file);
                                resolve()
                                break;
                        }
                    }catch(e){
                        console.log(e)
                        $('#alertWindow').append( $('<p></p>').text("Error parsing file: " + file.name) );
                        reject(e);
                    }
                });
            },
            
            Xccdf(file){
                scap = new DOMParser().parseFromString( window.atob( file.data.substr( file.data.indexOf('base64,') + 7 ) ) ,'text/xml');
                var version = scap.evaluate("//@style", scap, null, XPathResult.STRING_TYPE, null).stringValue;
                
                function ns(ns){
                    switch(ns){
                        case "cdf" : 
                            if(version == 'SCAP_1.2'){
                                return "http://checklists.nist.gov/xccdf/1.2";
                            }else{
                                return "http://checklists.nist.gov/xccdf/1.1";
                            }
                            break;
                        case "xsi" :
                            return "http://www.w3.org/2001/XMLSchema-instance";
                            break;
                        case "dc" : 
                            return "http://purl.org/dc/elements/1.1/";
                            break;
                    }
                }
                
                if(scap.evaluate("/cdf:Benchmark/cdf:title", scap, ns, XPathResult.STRING_TYPE, null).stringValue != ''){
                    try{
                        const scapData = {};
                        
                        scapData.title = scap.evaluate("/cdf:Benchmark/cdf:title", scap, ns, XPathResult.STRING_TYPE, null).stringValue;        
                        scapData.scanType = 'scap';
                        scapData.credentialed = true;
                        scapData.scanFile = file.name;
                        scapData.hostname = scap.evaluate('/cdf:Benchmark/cdf:TestResult/cdf:target', scap, ns, XPathResult.STRING_TYPE, null).stringValue;
                        scapData.ip = scap.evaluate('/cdf:Benchmark/cdf:TestResult/cdf:target-address', scap, ns, XPathResult.STRING_TYPE, null).stringValue;
                        
                        scapData.id = scap.evaluate("/cdf:Benchmark/@id", scap, ns, XPathResult.STRING_TYPE, null).stringValue;
                        scapData.os = scap.evaluate("/cdf:Benchmark/cdf:TestResult/cdf:target-facts/cdf:fact[./@name='urn:scap:fact:asset:identifier:os_name']", scap, ns, XPathResult.STRING_TYPE, null).stringValue;
                        
                        const vr = scap.evaluate("/cdf:Benchmark/cdf:version", scap, ns, XPathResult.STRING_TYPE, null).stringValue;
                        scapData.version = vr.split('.')[0] * 1;
                        
                        Number.isNaN("1.b".split('.')[1]*1)
                        
                        let rel = vr.split('.')[1] * 1;
                        if(Number.isNaN(rel)){
                            scapData.release = '';    
                        }else{
                            scapData.release = rel;
                        }
                        
                        
                        scapData.scanDate = moment( scap.evaluate("/cdf:Benchmark/cdf:TestResult/@start-time", scap, ns, XPathResult.STRING_TYPE, null).stringValue, moment.ISO_8601).format('MM/DD/YYYY HH:mm:ss');
                        scapData.scanStop = moment( scap.evaluate("/cdf:Benchmark/cdf:TestResult/@end-time", scap, ns, XPathResult.STRING_TYPE, null).stringValue, moment.ISO_8601).format('MM/DD/YYYY HH:mm:ss');
                        
                        scapData.openFindings = {
                            cat1: scap.evaluate("count(/cdf:Benchmark/cdf:TestResult/cdf:rule-result[./cdf:result!='pass' and ./@severity='high'])", scap, ns, XPathResult.STRING_TYPE, null).stringValue,
                            cat2: scap.evaluate("count(/cdf:Benchmark/cdf:TestResult/cdf:rule-result[./cdf:result!='pass' and ./@severity='medium'])", scap, ns, XPathResult.STRING_TYPE, null).stringValue,
                            cat3: scap.evaluate("count(/cdf:Benchmark/cdf:TestResult/cdf:rule-result[./cdf:result!='pass' and ./@severity='low'])", scap, ns, XPathResult.STRING_TYPE, null).stringValue,
                        };

                        scapData.scannerEdition = scap.evaluate("/cdf:Benchmark/cdf:TestResult/@test-system", scap, ns, XPathResult.STRING_TYPE, null).stringValue  
                        scapData.policy         = scap.evaluate("/cdf:Benchmark/cdf:TestResult/cdf:profile/@idref", scap, ns, XPathResult.STRING_TYPE, null).stringValue 
                        scapData.duration       = moment.duration( moment(scapData.scanStop).diff(moment(scapData.scanDate)) ).as('seconds')
                    
                        scapData.requirements = [];
                        
                        var iterator = scap.evaluate('/cdf:Benchmark/cdf:TestResult/cdf:rule-result', scap, ns, XPathResult.UNORDERED_NODE_ITERATOR_TYPE, null );
                        
                        try {
                            var thisNode = iterator.iterateNext();
                            while (thisNode) {
                                const vulnerability = {};
                                vuln = new DOMParser().parseFromString(thisNode.outerHTML,'text/xml');
                                
                                const s = vuln.evaluate("//cdf:result", vuln, ns, XPathResult.STRING_TYPE, null ).stringValue
                                switch(s){
                                    case "pass":
                                        vulnerability.status = "Completed";
                                        break;
                                    case "fail":
                                        vulnerability.status = "Ongoing";
                                        break;
                                    case "error":
                                        vulnerability.status = "Error";
                                        break;
                                    default:
                                        vulnerability.status = "Ongoing";
                                        break;
