{% extends 'base.html.twig' %}
{% import 'macros.html.twig' as ui %}

{% block title %}Cyber Trackr!{% endblock %}

{% block body %}
    <section class="hero" aria-labelledby="hero-headline">
        <div class="hero__top rise delay-1">
            <span class="stamp">&bull; Live &middot; Updated monthly</span>
            <span class="hero__issue">No. {{ "now"|date("m") }} &middot; {{ "now"|date("Y") }}</span>
        </div>

        <h1 id="hero-headline" class="hero__headline rise delay-2">
            The reference desk<br>
            <em>for cyber compliance.</em>
        </h1>

        <p class="hero__subhead rise delay-3">
            Browse and search every DoD STIG, NIST 800-53 control, CCI, and SCAP benchmark &mdash; kept in sync with DISA and NIST so you don&rsquo;t have to.
        </p>

        <form class="hero-search rise delay-4" onsubmit="return window.app.heroSubmit(event)" role="search">
            <i class="bi bi-search hero-search__icon" aria-hidden="true"></i>
            <input id="hero-search-input" type="search" class="hero-search__input"
                   placeholder="Search {{ stig_count|number_format }} STIGs, {{ controls_count|number_format }} controls, {{ cci_count|number_format }} CCIs&hellip;"
                   aria-label="Search the library" autocomplete="off">
            <button type="button"
                    id="hero-bookmark-trigger"
                    class="hero-search__bookmark saved-search-trigger"
                    data-saved-search-trigger
                    aria-label="Saved searches"
                    aria-expanded="false"
                    aria-controls="hero-bookmark-panel"
                    title="Saved searches">
                <i class="bi bi-bookmarks" aria-hidden="true"></i>
                <span class="saved-search-trigger__count" data-saved-count hidden></span>
            </button>
            <kbd>&#8984;K</kbd>
        </form>
        <div id="hero-bookmark-panel" class="saved-search-panel" hidden role="region" aria-label="Saved searches"></div>

        <div class="hero__try rise delay-4">
            <span class="hero__try-label">Try</span>
            <div class="chip-group scroll-x">
                <button type="button" class="chip" onclick="window.app.heroSearchFor('Windows 11')">Windows 11</button>
                <button type="button" class="chip" onclick="window.app.heroSearchFor('RHEL 9')">RHEL 9</button>
                <button type="button" class="chip" onclick="window.app.heroSearchFor('Kubernetes')">Kubernetes</button>
                <button type="button" class="chip" onclick="window.app.heroSearchFor('AC-2')">{{ ui.ident('AC-2') }}</button>
                <button type="button" class="chip" onclick="window.app.heroSearchFor('CCI-000196')">{{ ui.ident('CCI-000196') }}</button>
                <button type="button" class="chip" onclick="window.app.heroSearchFor('macOS Sequoia')">macOS Sequoia</button>
            </div>
        </div>

        <div class="hero__trust rise delay-5">
            {% if sync_status.disa %}
                <span class="hero__trust-item">
                    <span class="dot {{ sync_status.disa|freshness_tag }}" aria-hidden="true"></span>
                    Synced from DISA &middot; <time datetime="{{ sync_status.disa|date('c') }}">{{ sync_status.disa|rel_time }}</time>
                </span>
            {% endif %}
            <span class="hero__trust-item">
                <span class="dot fresh" aria-hidden="true"></span>
                API operational
            </span>
            <span class="hero__trust-item">
                {{ stig_count|number_format }} STIGs &middot; {{ controls_count|number_format }} controls &middot; {{ cci_count|number_format }} CCIs
            </span>
        </div>
    </section>

    <section class="value-prop" aria-labelledby="value-prop-eyebrow">
        <div class="rule-text" id="value-prop-eyebrow">&sect; I &middot; Why this site</div>

        <p class="value-prop__lead">
            Every STIG, control, and CCI &mdash; <em>cross-linked, searchable,</em> and ready to drop into a POAM.
        </p>

        <div class="value-prop__outcomes">
            <div class="value-prop__outcome">
                <span class="eyebrow">Speed</span>
                <h3 class="value-prop__outcome-title">Find it in under a second.</h3>
                <p>An inverted index spanning every rule, control, CCI, and AP. Search the whole library from one box &mdash; words, &ldquo;quoted phrases&rdquo;, IDs ({{ ui.ident('CM-6') }}, {{ ui.ident('CCI-000196') }}), and even typos all match.</p>
            </div>
            <div class="value-prop__outcome">
                <span class="eyebrow">Traceability</span>
                <h3 class="value-prop__outcome-title">Walk the chain end-to-end.</h3>
                <p>Click a STIG rule&rsquo;s CCI to land on the CCI page pre-filtered to that ID. Click its 800-53 reference to jump straight into the catalog entry. The crosslinks live on every page, not buried in a sidebar.</p>
            </div>
            <div class="value-prop__outcome">
                <span class="eyebrow">Automation</span>
                <h3 class="value-prop__outcome-title">Turn scans into deliverables.</h3>
                <p>Drop ACAS, SCAP, or CKL scan output into the report generator and export an eMASS-ready POAM &amp; RAR &mdash; no manual reconciliation, no Excel gymnastics.</p>
            </div>
        </div>

        <div class="value-prop__ctas">
            <a href="{{ path('stig') }}" class="cta-primary">
                Search STIGs
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
            <a href="{{ path('rmf_v5_view') }}" class="cta-secondary">
                Explore controls
            </a>
            <a href="{{ path('report_generator') }}" class="cta-secondary">
                Generate reports
            </a>
        </div>

        <div class="value-prop__vs">
            <h3 class="value-prop__vs-heading">Why this versus the usual stack?</h3>
            <div class="value-prop__vs-grid">
                <div class="value-prop__vs-item">
                    <span class="eyebrow">vs STIG Viewer</span>
                    <p>STIG Viewer hands you one document at a time. Cross-referencing a CCI back to its 800-53 control means hopping through PDFs. Here it&rsquo;s one click in either direction.</p>
                </div>
                <div class="value-prop__vs-item">
                    <span class="eyebrow">vs eMASS</span>
                    <p>eMASS is a workflow tool, not a research one &mdash; slow, access-restricted, and built for tracking packages, not exploring requirements. Look up here, document there.</p>
                </div>
                <div class="value-prop__vs-item">
                    <span class="eyebrow">vs SCAP tooling</span>
                    <p>SCAP scanners execute benchmarks but don&rsquo;t make the catalog browsable. This site mirrors SCAP, STIG, and CCI sources together so you can read the rule and its lineage in one place.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="workflows" aria-labelledby="workflows-eyebrow">
        <div class="rule-text" id="workflows-eyebrow">&sect; II &middot; Common workflows</div>

        <p class="workflows__lede">
            If you came here to do one specific thing &mdash; jump straight in.
        </p>

        <div class="chip-group workflows__chips">
            <a class="chip workflows__chip" href="{{ path('rmf_v5_view') }}">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                Build an SSP
            </a>
            <a class="chip workflows__chip" href="{{ path('report_generator') }}">
                <i class="bi bi-clipboard-data" aria-hidden="true"></i>
                Validate scan findings
            </a>
            <a class="chip workflows__chip" href="{{ path('stig') }}">
                <i class="bi bi-list-check" aria-hidden="true"></i>
                Audit a system
            </a>
            <a class="chip workflows__chip" href="{{ path('cci') }}">
                <i class="bi bi-link-45deg" aria-hidden="true"></i>
                Trace a CCI to a control
            </a>
            <a class="chip workflows__chip" href="{{ path('api_summary') }}">
                <i class="bi bi-code-square" aria-hidden="true"></i>
                Pull data via API
            </a>
        </div>
    </section>

    <section class="tile-grid" aria-labelledby="tile-grid-eyebrow">
        <div class="rule-text" id="tile-grid-eyebrow">&sect; III &middot; Browse the library</div>

        <div class="tile-grid__inner">
            <a href="{{ path('stig') }}" class="tile tile--tall span-7">
                <span class="eyebrow">Compliance Guides</span>
                <h2 class="tile-title">STIGs</h2>
                <p class="tile-meta">{{ stig_count|number_format }} guides &middot; latest from DISA</p>
                <i class="tile-arrow bi bi-arrow-up-right" aria-hidden="true"></i>
            </a>

            <a href="{{ path('rmf_v5_view') }}" class="tile span-5">
                <span class="eyebrow">NIST Controls</span>
                <h2 class="tile-title">800-53 <em>r5</em></h2>
                <p class="tile-meta">{{ controls_count|number_format }} controls &middot; current revision</p>
                <i class="tile-arrow bi bi-arrow-up-right" aria-hidden="true"></i>
            </a>

            <a href="{{ path('rmf_v4_view') }}" class="tile span-6">
                <span class="eyebrow">NIST Controls</span>
                <h2 class="tile-title">800-53 <em>r4</em></h2>
                <p class="tile-meta">Previous revision &middot; legacy systems</p>
                <i class="tile-arrow bi bi-arrow-up-right" aria-hidden="true"></i>
            </a>

            <a href="{{ path('cci') }}" class="tile span-6">
                <span class="eyebrow">Control Indicators</span>
                <h2 class="tile-title">CCIs</h2>
                <p class="tile-meta">{{ cci_count|number_format }} items &middot; control mappings</p>
                <i class="tile-arrow bi bi-arrow-up-right" aria-hidden="true"></i>
            </a>

            <a href="{{ path('report_generator') }}" class="tile span-5">
                <span class="eyebrow">Tools</span>
                <h2 class="tile-title">Scans &rsaquo; Reports</h2>
                <p class="tile-meta">Convert ACAS / SCAP / CKL scans into eMASS-compatible POAM &amp; RAR spreadsheets</p>
                <i class="tile-arrow bi bi-arrow-up-right" aria-hidden="true"></i>
            </a>

            <a href="{{ path('scap') }}" class="tile span-4">
                <span class="eyebrow">Automation</span>
                <h2 class="tile-title">SCAP</h2>
                <p class="tile-meta">Benchmarks &amp; OVAL definitions</p>
                <i class="tile-arrow bi bi-arrow-up-right" aria-hidden="true"></i>
            </a>

            <a href="{{ path('api_summary') }}" class="tile span-3">
                <span class="eyebrow">Developers</span>
                <h2 class="tile-title">API</h2>
                <p class="tile-meta">REST endpoints</p>
                <i class="tile-arrow bi bi-arrow-up-right" aria-hidden="true"></i>
            </a>
        </div>
    </section>

    <section class="lib-page" aria-labelledby="recent-stigs-eyebrow">
        <div class="rule-text" id="recent-stigs-eyebrow">&sect; IV &middot; Recent updates</div>

        <div class="lib-page__bar">
            <div class="lib-page__head">
                <span class="eyebrow">Latest releases</span>
                <h2 class="lib-page__title">Fresh from <em>DISA</em></h2>
            </div>
            <div class="lib-page__filter">
                <input id="recent-stigs-q" type="search" placeholder="Filter last 100 by name or version&hellip;"
                       aria-label="Filter recent STIGs" oninput="window.app.recentFilter()">
                <div class="chip-group" role="radiogroup" aria-label="Filter by age">
                    <button type="button" class="chip active" data-age="all"   onclick="window.app.recentAge(this)">All ages</button>
                    <button type="button" class="chip"        data-age="fresh" onclick="window.app.recentAge(this)">Fresh &le; 1y</button>
                    <button type="button" class="chip"        data-age="stale" onclick="window.app.recentAge(this)">Stale 1&ndash;3y</button>
                    <button type="button" class="chip"        data-age="aged"  onclick="window.app.recentAge(this)">Aged 3&ndash;5y</button>
                </div>
            </div>
        </div>

        <div class="lib-page__legend" aria-hidden="true">
            <span><span class="dot fresh"></span> Fresh &middot; &le; 1 yr</span>
            <span><span class="dot stale"></span> Stale &middot; 1&ndash;3 yr</span>
            <span><span class="dot aged"></span>  Aged &middot; 3&ndash;5 yr</span>
            <span><span class="dot old"></span>   Old &middot; &gt; 5 yr</span>
        </div>

        <div class="data-table-wrap">
            <div class="data-table-scroll">
                <table id="recent-stigs-table" class="data-table">
                    <thead>
                        <tr>
                            <th data-sort-key="name"     data-sort-type="string">Name <span class="sort-ind"></span></th>
                            <th data-sort-key="version"  data-sort-type="string">Version <span class="sort-ind"></span></th>
                            <th data-sort-key="released" data-sort-type="date" class="sorted desc" aria-sort="descending">Released <span class="sort-ind">&darr;</span></th>
                            <th>Severity Mix</th>
                            <th data-sort-key="rules"    data-sort-type="number" class="num">Rules <span class="sort-ind"></span></th>
                            <th>Freshness</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for s in recent_stigs %}
                            {% set hi  = s.sev.h|default(0) %}
                            {% set med = s.sev.m|default(0) %}
                            {% set low = s.sev.l|default(0) %}
                            {% set rules_total = hi + med + low %}
                            {% set rel_trim = s.released|default('')|trim %}
                            {% set tag = rel_trim is empty ? 'old' : (s.released|freshness_tag) %}
                            {% set rel_iso = rel_trim is empty ? '' : (s.released|date('Y-m-d')) %}
                            <tr data-name="{{ s.title|replace({'_': ' '})|lower }}"
                                data-version="V{{ s.version }}R{{ s.release }}"
                                data-age="{{ tag }}"
                                data-released="{{ rel_iso }}"
                                data-rules="{{ rules_total }}">
                                <td data-label="Name"><a href="{{ path('stig_view', {title: s.title, version: s.version, release: s.release}) }}">{{ s.title|replace({'_': ' '}) }}</a></td>
                                <td data-label="Version">{{ ui.ident('V' ~ s.version ~ 'R' ~ s.release) }}</td>
                                <td data-label="Released">{% if s.released|default('')|trim %}{{ s.released|date("d M Y") }}{% endif %}</td>
                                <td data-label="Severity Mix">
                                    <span class="sev-mix">
                                        {{ ui.sev_bar(hi, med, low) }}
                                        {% if hi  > 0 %}{{ ui.sev('high', hi) }}{% endif %}
                                        {% if med > 0 %}{{ ui.sev('med',  med) }}{% endif %}
                                        {% if low > 0 %}{{ ui.sev('low',  low) }}{% endif %}
                                    </span>
                                </td>
                                <td data-label="Rules" class="num">{{ rules_total|number_format }}</td>
                                <td data-label="Freshness">{% if s.released|default('')|trim %}{{ ui.freshness(s.released) }}{% endif %}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="data-table-foot">
                <span id="recent-stigs-count" data-total="{{ stig_count }}" aria-live="polite">Showing {{ recent_stigs|length }} of {{ stig_count|number_format }} STIGs</span>
                <a href="{{ path('stig') }}">View entire library &rsaquo;</a>
            </div>
        </div>
    </section>

    <section class="colophon" aria-labelledby="colophon-eyebrow">
        <div class="rule-text" id="colophon-eyebrow">&sect; V &middot; Colophon</div>

        <div class="colophon__inner">
            <div class="colophon__left">
                <span class="eyebrow">About</span>
                <h2 class="colophon__heading">
                    Built by one engineer,<br>
                    <em>for the community.</em>
                </h2>
            </div>

            <div class="colophon__right">
                <p class="colophon__quote">
                    Built to help everyone in the Cyber Domain with the RMF and STIG requirements &mdash; making the crosslinking between vulnerabilities, STIG rules, and CCIs easier to manage. The site mirrors authoritative sources from DISA and NIST so you can spend less time hunting and more time implementing.
                </p>
                <p class="colophon__body">
                    I&rsquo;m Robert Weber, a DoD contractor working across multiple IT/IA fields &mdash; RMF, STIG implementation, SCAP compliance, vulnerability scans. This suite is built on my off-hours: no corporate backing, no funding, just updates as my free time permits. Feedback is always welcome &mdash; please send it.
                </p>
                <div class="colophon__ctas">
                    <a href="{{ path('contact_us') }}" class="cta-primary">
                        Contact &amp; feedback
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </a>
                    <a href="https://github.com/CyberSecDef" class="cta-secondary" target="_blank" rel="noopener noreferrer">
                        <i class="bi bi-github" aria-hidden="true"></i>
                        View on GitHub
                    </a>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
