{#
 # UI macros — small reusable presentation primitives.
 #
 # Import in templates with:
 #   {% import 'macros.html.twig' as ui %}
 #
 # Then call:
 #   {{ ui.ident('CCI-000196') }}
 #
 # Macros here should be cheap, dumb, and dependency-free. No xpath, no logic
 # beyond formatting. If a macro grows complex, promote it to a Twig extension.
 #}

{#
 # ident — wraps a technical identifier in a monospace pill.
 #
 # Use for: STIG version strings (V2R7), RMF control IDs (AC-2), CCI numbers
 # (CCI-000196), rule IDs, vuln IDs, SRG references.
 #
 # Trims the value so accidental whitespace from xpath results doesn't leak
 # into the rendered pill. Do NOT pass HTML — value is escaped.
 #}
{% macro ident(value) %}<span class="ident">{{ value|trim }}</span>{% endmacro %}

{#
 # rmf_link — control number rendered as a clickable .ident pill that
 # deep-links to the 800-53 Rev 5 page anchored at #rmf_<num>. The
 # anchor format matches the <a id="rmf_{{control.number}}"> emitted
 # by templates/rmf/view_v5.html.twig.
 #
 # Use on STIG/SCAP detail pages where a control is named so users get
 # a one-click jump to the full control text. Renders nothing when
 # value is empty/whitespace.
 #}
{% macro rmf_link(value) %}
{%- set v = value|trim -%}
{%- if v != '' -%}
<a class="ident ident--link" href="{{ path('rmf_v5_view') }}#rmf_{{ v }}" title="View {{ v }} on the 800-53 Rev 5 page">{{ v }}</a>
{%- endif -%}
{% endmacro %}

{#
 # cci_link — CCI id rendered as a clickable .ident pill. The CCI page
 # uses a DataTable, so we pass the id via URL fragment (#CCI-000366);
 # cci_app.init() reads location.hash on load + on hashchange and
 # applies it as the table's search filter.
 #
 # Renders nothing for empty/whitespace values.
 #}
{% macro cci_link(value) %}
{%- set v = value|trim -%}
{%- if v != '' -%}
<a class="ident ident--link" href="{{ path('cci') }}#{{ v }}" title="View {{ v }} on the CCI page">{{ v }}</a>
{%- endif -%}
{% endmacro %}

{#
 # sev — severity pill.
 #
 # Accepts level as 'high' | 'medium' | 'med' | 'low'. Optional count appends
 # a · separator. Renders short-form letter by default ("H · 30").
 #
 # Examples:
 #   {{ ui.sev('high', 30) }}       → <span class="sev high" aria-…>H · 30</span>
 #   {{ ui.sev(rule.severity) }}    → <span class="sev high">H</span>
 #
 # For interactive filter buttons (Bootstrap data-bs-toggle="button"), apply
 # .sev .high/.med/.low .is-filter classes directly on the button element
 # rather than calling this macro.
 #}
{% macro sev(level, count = null) %}
{%- set lvl = level|lower -%}
{%- set cls = {high: 'high', medium: 'med', med: 'med', low: 'low'}[lvl]|default(lvl) -%}
{%- set short = {high: 'H', med: 'M', low: 'L'}[cls]|default(lvl|first|upper) -%}
{%- set lbl = {high: 'High', med: 'Medium', low: 'Low'}[cls]|default(lvl|capitalize) -%}
{%- set aria = lbl ~ ' severity' ~ (count is not null ? ', ' ~ count ~ ' rules' : '') -%}
<span class="sev {{ cls }}" aria-label="{{ aria }}">{{ short }}{% if count is not null %} · {{ count }}{% endif %}</span>
{%- endmacro %}

{#
 # sev_bar — proportional severity strip (96×5px) showing high/med/low mix.
 #
 # Widths are calculated as percentages of the total. Renders nothing when
 # total is zero. Inline width styles are intentional per spec §22 — they're
 # data-driven values, not arbitrary styling.
 #
 #   {{ ui.sev_bar(30, 239, 12) }}
 #}
{% macro sev_bar(high, med, low) %}
{%- set h = high|default(0) -%}
{%- set m = med|default(0) -%}
{%- set l = low|default(0) -%}
{%- set total = h + m + l -%}
{%- if total > 0 -%}
<span class="sev-bar" title="High {{ h }} · Medium {{ m }} · Low {{ l }}" role="img" aria-label="Severity proportion: {{ h }} high, {{ m }} medium, {{ l }} low"><span class="h" style="width: {{ (h * 100 / total)|round(2) }}%"></span><span class="m" style="width: {{ (m * 100 / total)|round(2) }}%"></span><span class="l" style="width: {{ (l * 100 / total)|round(2) }}%"></span></span>
{%- endif -%}
{% endmacro %}

{#
 # freshness — colored age dot paired with a human relative-time label.
 #
 # Renders nothing meaningful for empty/missing dates (a gray "old" dot
 # with "unknown"). Otherwise pairs a .dot.{fresh|stale|aged|old} with
 # a <time> element carrying the ISO datetime for accessibility.
 #
 #   {{ ui.freshness(s.released) }}
 #}
{% macro freshness(date) %}
{%- set tag = date|freshness_tag -%}
{%- set rel = date|rel_time -%}
{%- set iso = date is empty ? '' : (date|date('c')) -%}
<span class="freshness"><span class="dot {{ tag }}" aria-hidden="true"></span> · <time class="font-mono"{% if iso %} datetime="{{ iso }}"{% endif %}>{{ rel }}</time></span>
{%- endmacro %}
