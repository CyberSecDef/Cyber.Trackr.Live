<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="This website was created to help everyone in the Cyber Domain with the new RMF and STIG requirements.">
        <meta name="keywords" content="RMF, STIG, SCAP, CCI">

        <title>{% block title %}Welcome!{% endblock %}</title>

        {# Preflight: apply stored / system theme synchronously to prevent FOUC. #}
        <script>
            (function () {
                try {
                    var stored = localStorage.getItem('theme');
                    var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                    document.documentElement.dataset.theme = theme;
                } catch (e) { /* localStorage unavailable — fall back to default */ }
            })();
        </script>

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,SOFT,wght@0,9..144,0..100,300..900;1,9..144,0..100,300..900&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap">

        {% block stylesheets %}
            <link rel="stylesheet" href="/css/bootstrap.min.css" />
            <link rel="stylesheet" href="/css/bootstrap-icons.css" />
            <link rel="stylesheet" href="/css/datatables.min.css" />
            <link rel="stylesheet" href="/css/app.css" />
        {% endblock %}

        {% block javascripts %}
            <script src="/js/jquery-3.7.1.min.js"></script>
            <script src="/js/bootstrap.bundle.min.js"></script>
            <script src="/js/datatables.min.js"></script>
            <script src="/js/diff_match_patch.js"></script>
            <script src="/js/dist_masonry.pkgd.min.js"></script>
            <script src="/js/js.cookie.min.js"></script>
            <script>
                window.routes = {
                    search: "{{ path('search', {query: 'REPLACE_THIS'}) }}"
                };
            </script>
            <script src="/js/app.js"></script>
        {% endblock %}

        <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
        <link rel="manifest" href="/images/site.webmanifest">
    </head>
    <body class="grain">
        <a class="skip-link" href="#main">Skip to content</a>

        <header class="site-header">
            <div class="site-header__inner">
                <a href="{{ path('home') }}" class="site-brand" aria-label="Cyber Trackr — home">
                    <span class="seal" aria-hidden="true">CT</span>
                    <span class="site-brand__label">
                        <span class="site-brand__name">Cyber · Trackr</span>
                        <span class="site-brand__tagline font-display-italic">The Free Compliance Library</span>
                    </span>
                </a>

                <nav class="site-nav" aria-label="Primary">
                    <a href="{{ path('stig') }}">STIGs</a>
                    <a href="{{ path('rmf_v5_view') }}">800-53 r5</a>
                    <a href="{{ path('rmf_v4_view') }}">800-53 r4</a>
                    <a href="{{ path('cci') }}">CCIs</a>
                    <a href="{{ path('scap') }}">SCAP</a>
                    <a href="{{ path('report_generator') }}">Scans &rsaquo; Reports</a>
                    <a href="{{ path('api_summary') }}">API</a>
                    <a href="{{ path('contact_us') }}">Contact</a>
                </nav>

                <div class="site-actions">
                    <div class="site-search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input type="search" id="search_terms" class="site-search__input" placeholder="Search the library&hellip;" aria-label="Search the library" autocomplete="off">
                        <kbd class="site-search__kbd" title="Press Cmd/Ctrl + K to focus search">&#8984;K</kbd>
                    </div>
                    <button type="button" class="theme-toggle" onclick="window.app.theme.toggle()" aria-label="Toggle color theme" aria-pressed="false">
                        <i class="bi bi-moon-stars" data-theme-icon="show-in-light" aria-hidden="true"></i>
                        <i class="bi bi-sun" data-theme-icon="show-in-dark" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </header>

        <main id="main" class="site-main">
            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            <div class="site-footer__inner">
                <div class="site-footer__columns">
                    <div>
                        <h3 class="site-footer__heading">Library</h3>
                        <ul class="site-footer__links">
                            <li><a href="{{ path('stig') }}">STIGs</a></li>
                            <li><a href="{{ path('rmf_v5_view') }}">800-53 r5</a></li>
                            <li><a href="{{ path('rmf_v4_view') }}">800-53 r4</a></li>
                            <li><a href="{{ path('cci') }}">CCIs</a></li>
                            <li><a href="{{ path('scap') }}">SCAP</a></li>
                        </ul>
                    </div>

                    <div>
                        <h3 class="site-footer__heading">Tools</h3>
                        <ul class="site-footer__links">
                            <li><a href="{{ path('report_generator') }}">Scans &rsaquo; Reports</a></li>
                            <li><a href="{{ path('stig') }}">Diff engine</a></li>
                            <li><a href="{{ path('api_summary') }}">REST API</a></li>
                            <li><a href="#" aria-disabled="true" data-coming-soon>Ruby gem</a></li>
                        </ul>
                    </div>

                    <div>
                        <h3 class="site-footer__heading">About</h3>
                        <ul class="site-footer__links">
                            <li><a href="{{ path('home') }}">Mission</a></li>
                            <li><a href="{{ path('contact_us') }}">Contact</a></li>
                            <li><a href="#" aria-disabled="true" data-coming-soon>GitHub</a></li>
                        </ul>
                    </div>

                    <div>
                        <h3 class="site-footer__heading">Status</h3>
                        <ul class="site-footer__status">
                            <li>
                                <span class="dot fresh" aria-hidden="true"></span>
                                <span>All systems operational</span>
                            </li>
                            {% if sync_status.disa %}
                                <li>DISA sync &middot; {{ sync_status.disa|date("d M Y") }}</li>
                            {% endif %}
                            {% if sync_status.nist %}
                                <li>NIST sync &middot; {{ sync_status.nist|date("d M Y") }}</li>
                            {% endif %}
                            <li>v1.0.0</li>
                        </ul>
                    </div>
                </div>

                <div class="site-footer__strip">
                    <div class="site-footer__strip-left">
                        <span class="seal seal--small" aria-hidden="true">CT</span>
                        <span>Cyber Trackr &middot; est. MMXIX</span>
                    </div>
                    <div class="site-footer__strip-right font-display-italic">
                        &ldquo;Compliance, made legible.&rdquo;
                    </div>
                </div>
            </div>
        </footer>
    </body>
</html>
