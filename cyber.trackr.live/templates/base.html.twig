<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>{% block title %}Welcome!{% endblock %}</title>

        {# Per-page metadata. Each child template can override:
            - {% block og_title %}{% endblock %}        — short, ≤70 char
            - {% block og_description %}{% endblock %}  — 1–2 sentences
            - {% block og_image_name %}{% endblock %}   — filename stem in public/og/<name>.png
            - {% block og_type %}{% endblock %}         — defaults to "website"; "article" for compare/digest pages
           Defaults below cover home; everything else opts in. #}
        {% set _og_title       %}{% block og_title %}Cyber Trackr — DoD compliance reference{% endblock %}{% endset %}
        {% set _og_description %}{% block og_description %}Free reference for STIGs, NIST 800-53 controls, CCIs, and SCAP benchmarks — searchable, cross-linked, kept in sync with DISA and NIST.{% endblock %}{% endset %}
        {% set _og_image_name  %}{% block og_image_name %}home{% endblock %}{% endset %}
        {% set _og_type        %}{% block og_type %}website{% endblock %}{% endset %}
        {% set _og_title       = _og_title|trim %}
        {% set _og_description = _og_description|trim %}
        {% set _og_image_name  = _og_image_name|trim %}
        {% set _og_type        = _og_type|trim %}
        {% set _og_image_url   = absolute_url('/og/' ~ _og_image_name ~ '.png') %}

        <meta name="description" content="{{ _og_description }}">
        <meta name="keywords" content="RMF, STIG, SCAP, CCI, NIST 800-53, DISA, FedRAMP, compliance">

        {# Open Graph (Facebook / LinkedIn / Slack / Discord / generic). #}
        <meta property="og:type" content="{{ _og_type }}">
        <meta property="og:site_name" content="Cyber Trackr">
        <meta property="og:title" content="{{ _og_title }}">
        <meta property="og:description" content="{{ _og_description }}">
        <meta property="og:url" content="{{ absolute_url(app.request.uri) }}">
        <meta property="og:image" content="{{ _og_image_url }}">
        <meta property="og:image:type" content="image/png">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="{{ _og_title }}">
        <meta property="og:locale" content="en_US">

        {# Twitter / X. summary_large_image because all 8 OG images are 1200×630. #}
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ _og_title }}">
        <meta name="twitter:description" content="{{ _og_description }}">
        <meta name="twitter:image" content="{{ _og_image_url }}">
        <meta name="twitter:image:alt" content="{{ _og_title }}">

        {# Canonical link helps search dedupe identical content reachable via
           multiple URLs (e.g., the dev/127.0.0.1 vs prod hostname). #}
        <link rel="canonical" href="{{ absolute_url(app.request.pathInfo) }}">

        {# JSON-LD structured data — WebSite schema is included on every page so
           search engines understand the site identity + sitelinks search box.
           Inner pages may add a BreadcrumbList via {% block jsonld_extra %}. #}
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": "Cyber Trackr",
            "alternateName": "Cyber · Trackr",
            "url": "{{ absolute_url('/') }}",
            "description": "{{ _og_description|e('js') }}",
            "potentialAction": {
                "@type": "SearchAction",
                "target": {
                    "@type": "EntryPoint",
                    "urlTemplate": "{{ absolute_url('/search/{search_term_string}') }}"
                },
                "query-input": "required name=search_term_string"
            }
        }
        </script>
        {% block jsonld_extra %}{% endblock %}

        {# Preflight: apply stored / system theme synchronously to prevent FOUC.
           Also migrates legacy values (light → paper, dark → ink) and rejects
           any unknown stored value, falling back to system preference. #}
        <script>
            (function () {
                var THEMES = ['paper','ink','mono','solarized-light','solarized-dark','nord','dracula','high-contrast'];
                var LEGACY = { light: 'paper', dark: 'ink' };
                try {
                    var stored = localStorage.getItem('theme');
                    if (stored && LEGACY[stored]) {
                        stored = LEGACY[stored];
                        localStorage.setItem('theme', stored);
                    }
                    if (stored && THEMES.indexOf(stored) === -1) {
                        stored = null;
                    }
                    var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'ink' : 'paper');
                    document.documentElement.dataset.theme = theme;
                } catch (e) { /* localStorage unavailable — fall back to default */ }
            })();
        </script>

        {# Self-hosted fonts — @font-face declarations live in app.css. Preload
           the Fraunces normal woff2 since it's used by every hero h1 above the fold. #}
        <link rel="preload" href="/fonts/fraunces-300_900-normal.woff2" as="font" type="font/woff2" crossorigin>

        {% block stylesheets %}
            <link rel="stylesheet" href="/css/bootstrap.min.css" />
            <link rel="stylesheet" href="/css/bootstrap-icons.css" />
            <link rel="stylesheet" href="/css/datatables.min.css" />
            <link rel="stylesheet" href="/css/app.css" />
        {% endblock %}

        {# Feed-reader auto-discovery — the STIG updates Atom feed. #}
        <link rel="alternate" type="application/atom+xml" title="Cyber Trackr — STIG updates" href="{{ path('stig_feed') }}" />

        {% block javascripts %}
            <script src="/js/jquery-3.7.1.min.js"></script>
            <script src="/js/bootstrap.bundle.min.js"></script>
            <script src="/js/datatables.min.js"></script>
            <script src="/js/diff_match_patch.js"></script>
            <script src="/js/dist_masonry.pkgd.min.js"></script>
            <script src="/js/js.cookie.min.js"></script>
            <script>
                window.routes = {
                    search: "{{ path('search', {query: 'REPLACE_THIS'}) }}"
                };
            </script>
            <script src="/js/app.js"></script>
            <script src="/js/saved_searches.js"></script>
        {% endblock %}

        <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
        <link rel="manifest" href="/images/site.webmanifest">
    </head>
    <body>
        <a class="skip-link" href="#main">Skip to content</a>

        <header class="site-header">
            <div class="site-header__inner">
                <a href="{{ path('home') }}" class="site-brand" aria-label="Cyber Trackr — home">
                    <span class="seal" aria-hidden="true">CT</span>
                    <span class="site-brand__label">
                        <span class="site-brand__name">Cyber · Trackr</span>
                        <span class="site-brand__tagline font-display-italic">The Free Compliance Library</span>
                    </span>
                </a>

                <nav id="site-nav" class="site-nav" aria-label="Primary">
                    <a href="{{ path('stig') }}">STIGs</a>
                    <a href="{{ path('scap') }}">SCAPs</a>
                    <a href="{{ path('cci') }}">CCIs</a>
                    <details class="site-nav__menu">
                        <summary class="site-nav__menu-trigger">
                            800-53 <i class="bi bi-chevron-down site-nav__menu-chevron" aria-hidden="true"></i>
                        </summary>
                        <div class="site-nav__submenu" role="menu">
                            <a href="{{ path('rmf_v4_view') }}" role="menuitem">Rev 4</a>
                            <a href="{{ path('rmf_v5_view') }}" role="menuitem">Rev 5</a>
                            <a href="{{ path('rmf_4_to_5_view') }}" role="menuitem">r4 &rarr; r5 mapping</a>
                            <a href="{{ path('baselines_view') }}" role="menuitem">Baseline coverage</a>
                        </div>
                    </details>
                    <a href="{{ path('report_generator') }}">Scans to Reports</a>
                    <a href="{{ path('ckl_viewer') }}">CKL Viewer</a>
                    <a href="{{ path('plans') }}">Plan Generator</a>
                    <a href="{{ path('api_summary') }}">API</a>
                    <a href="{{ path('contact_us') }}">Contact</a>
                    <a href="{{ path('mission') }}">Mission</a>
                </nav>

                <div class="site-actions">
                    <div class="site-search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input type="search" id="search_terms" class="site-search__input" placeholder="Search the library&hellip;" aria-label="Search the library" autocomplete="off">
                        <kbd class="site-search__kbd" title="Press Cmd/Ctrl + K to focus search">&#8984;K</kbd>
                    </div>
                    <div class="theme-menu">
                        <button type="button" class="theme-toggle" onclick="window.app.theme.menuToggle(this)"
                                aria-label="Choose color theme" aria-haspopup="true" aria-expanded="false">
                            <i class="bi bi-palette" aria-hidden="true"></i>
                        </button>
                        <div class="theme-menu__panel" role="menu" hidden>
                            {% set theme_options = [
                                { name: 'paper',           label: 'Paper',           bg: '#f4efe2', fg: '#1a1612', accent: '#7a1e1e' },
                                { name: 'ink',             label: 'Ink',             bg: '#15120c', fg: '#ece2c8', accent: '#d4a04a' },
                                { name: 'mono',            label: 'Mono (print)',    bg: '#ffffff', fg: '#000000', accent: '#000000' },
                                { name: 'solarized-light', label: 'Solarized Light', bg: '#fdf6e3', fg: '#073642', accent: '#268bd2' },
                                { name: 'solarized-dark',  label: 'Solarized Dark',  bg: '#002b36', fg: '#eee8d5', accent: '#268bd2' },
                                { name: 'nord',            label: 'Nord',            bg: '#2e3440', fg: '#eceff4', accent: '#88c0d0' },
                                { name: 'dracula',         label: 'Dracula',         bg: '#282a36', fg: '#f8f8f2', accent: '#bd93f9' },
                                { name: 'high-contrast',   label: 'High Contrast',   bg: '#000000', fg: '#ffffff', accent: '#ffff00' }
                            ] %}
                            {% for t in theme_options %}
                                <button type="button" class="theme-menu__item" role="menuitemradio"
                                        data-theme-name="{{ t.name }}" aria-checked="false"
                                        onclick="window.app.theme.set('{{ t.name }}')">
                                    <span class="theme-menu__swatch" aria-hidden="true"
                                          style="--swatch-bg: {{ t.bg }}; --swatch-fg: {{ t.fg }}; --swatch-accent: {{ t.accent }}"></span>
                                    <span class="theme-menu__label">{{ t.label }}</span>
                                    <i class="bi bi-check theme-menu__check" aria-hidden="true"></i>
                                </button>
                            {% endfor %}
                        </div>
                    </div>
                    <button type="button" class="nav-toggle icon-btn" onclick="window.app.navToggle(this)" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="site-nav">
                        <i class="bi bi-list" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </header>

        <main id="main" class="site-main">
            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            <div class="site-footer__inner">
                <div class="site-footer__columns">
                    <div>
                        <h3 class="site-footer__heading">Library</h3>
                        <ul class="site-footer__links">
                            <li><a href="{{ path('stig') }}">STIGs</a></li>
                            <li><a href="{{ path('rmf_v5_view') }}">800-53 r5</a></li>
                            <li><a href="{{ path('rmf_v4_view') }}">800-53 r4</a></li>
                            <li><a href="{{ path('rmf_4_to_5_view') }}">r4 &rarr; r5 mapping</a></li>
                            <li><a href="{{ path('baselines_view') }}">Baseline coverage</a></li>
                            <li><a href="{{ path('cci') }}">CCIs</a></li>
                            <li><a href="{{ path('scap') }}">SCAP</a></li>
                        </ul>
                    </div>

                    <div>
                        <h3 class="site-footer__heading">Tools</h3>
                        <ul class="site-footer__links">
                            <li><a href="{{ path('report_generator') }}">Scans &rsaquo; Reports</a></li>
                            <li><a href="{{ path('ckl_viewer') }}">CKL Viewer</a></li>
                            <li><a href="{{ path('plans') }}">Plan Generator</a></li>
                            <li><a href="{{ path('api_summary') }}">REST API</a></li>
                        </ul>
                    </div>

                    <div>
                        <h3 class="site-footer__heading">About</h3>
                        <ul class="site-footer__links">
                            <li><a href="{{ path('mission') }}">Mission</a></li>
                            <li><a href="{{ path('contact_us') }}">Contact</a></li>
                            <li><a href="https://github.com/CyberSecDef" target="_blank" rel="noopener noreferrer">GitHub</a></li>
                        </ul>
                    </div>

                    <div>
                        <h3 class="site-footer__heading">Status</h3>
                        <ul class="site-footer__status">
                            <li>
                                <span class="dot fresh" aria-hidden="true"></span>
                                <span>All systems operational</span>
                            </li>
                            {% if sync_status.disa %}
                                <li>DISA sync &middot; {{ sync_status.disa|date("d M Y") }}</li>
                            {% endif %}
                            {% if sync_status.nist %}
                                <li>NIST sync &middot; {{ sync_status.nist|date("d M Y") }}</li>
                            {% endif %}
                            <li>v{{ app_version }}</li>
                        </ul>
                    </div>
                </div>

                <div class="site-footer__strip">
                    <div class="site-footer__strip-left">
                        <span class="seal seal--small" aria-hidden="true">CT</span>
                        <span>Cyber Trackr &middot; est. MMXIX</span>
                    </div>
                    <div class="site-footer__strip-right font-display-italic">
                        &ldquo;Compliance, made legible.&rdquo;
                    </div>
                </div>
            </div>
        </footer>
    </body>
</html>
