{% extends 'base.html.twig' %}
{% import 'macros.html.twig' as ui %}

{% block title %}View SCAP - {{ scap.xpath("//xccdf:Benchmark/xccdf:title")|first }} V{{ version }}R{{ release }}{% endblock %}

{% block body %}
    {% set xml_title      = scap.xpath("//xccdf:Benchmark/xccdf:title")|first %}
    {% set published_date = scap.xpath("//xccdf:Benchmark/xccdf:status/@date")|first %}
    {% set hi_count       = scap.xpath(".//xccdf:Rule[@severity = 'high']")|length %}
    {% set med_count      = scap.xpath(".//xccdf:Rule[@severity = 'medium']")|length %}
    {% set low_count      = scap.xpath(".//xccdf:Rule[@severity = 'low']")|length %}
    {% set rules_total    = hi_count + med_count + low_count %}

    <article class="stig-detail">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
            <ol>
                <li><a href="{{ path('scap') }}">SCAP</a></li>
                <li aria-current="page">{{ title|replace({'_': ' '}) }}</li>
            </ol>
        </nav>

        <header class="stig-detail__header">
            <div class="stig-detail__header-text">
                <span class="eyebrow">DoD Compliance &middot; SCAP</span>
                <h1 class="stig-detail__title">{{ xml_title }}</h1>
                <div class="stig-detail__meta">
                    {{ ui.ident('V' ~ version ~ 'R' ~ release) }}
                    {% if published_date %}
                        <span>&middot;</span>
                        {{ ui.freshness(published_date) }}
                        <span>&middot; Published {{ published_date|date("d M Y") }}</span>
                    {% endif %}
                    <span>&middot; {{ rules_total|number_format }} rules</span>
                </div>
            </div>
            <div class="stig-detail__actions">
                <button type="button" class="icon-btn" onclick="scap_app.download();" title="Download original XCCDF" aria-label="Download original XCCDF">
                    <i class="bi bi-cloud-download" aria-hidden="true"></i>
                </button>
            </div>
        </header>

        <div class="stat-cards" role="group" aria-label="Severity filters">
            <button type="button" class="stat-card high active" data-bs-toggle="button" aria-pressed="true" onclick="scap_app.toggleFilter(this, 'high');" aria-label="Toggle {{ hi_count }} high-severity rules">
                <span class="stat-card__num">{{ hi_count|number_format }}</span>
                <span class="stat-card__label">High severity</span>
            </button>
            <button type="button" class="stat-card med active" data-bs-toggle="button" aria-pressed="true" onclick="scap_app.toggleFilter(this, 'medium');" aria-label="Toggle {{ med_count }} medium-severity rules">
                <span class="stat-card__num">{{ med_count|number_format }}</span>
                <span class="stat-card__label">Medium severity</span>
            </button>
            <button type="button" class="stat-card low active" data-bs-toggle="button" aria-pressed="true" onclick="scap_app.toggleFilter(this, 'low');" aria-label="Toggle {{ low_count }} low-severity rules">
                <span class="stat-card__num">{{ low_count|number_format }}</span>
                <span class="stat-card__label">Low severity</span>
            </button>
        </div>

        <section class="versions-panel versions-panel--single" aria-label="Versions">
            <div class="versions-panel__col">
                <span class="eyebrow">View</span>
                <p class="versions-panel__hint">Open a previous version of this SCAP benchmark.</p>
                <div class="versions-panel__controls">
                    <select id="view_scap" aria-label="Open version">
                        <option value="" selected>Choose&hellip;</option>
                        {% for s in scaps|sort((a, b) => a.date <=> b.date)|reverse %}
                            <option value="{{s.version}}|{{s.release}}">V{{s.version}}R{{s.release}}</option>
                        {% endfor %}
                    </select>
                    <button type="button" class="cta-primary" onclick="scap_app.view()">View</button>
                </div>
            </div>
        </section>

        <div class="doc-desc">
            {{ scap.xpath("//xccdf:Benchmark/xccdf:description")|first }}
        </div>

        <div class="rule-controls">
            <div class="rule-controls__group">
                <span class="eyebrow">Sort by</span>
                <div class="chip-group" role="radiogroup" aria-label="Sort rules by">
                    <button type="button" class="chip" role="radio" aria-checked="false" data-sort="control"  onclick="scap_app.sort(this);">Control</button>
                    <button type="button" class="chip" role="radio" aria-checked="false" data-sort="severity" onclick="scap_app.sort(this);">Severity</button>
                    <button type="button" class="chip" role="radio" aria-checked="false" data-sort="vuln"     onclick="scap_app.sort(this);">Vuln</button>
                    <button type="button" class="chip" role="radio" aria-checked="false" data-sort="title"    onclick="scap_app.sort(this);">Title</button>
                </div>
            </div>
        </div>

        <div id="requirements" class="">
        {% set groups = scap.xpath("//xccdf:Benchmark/xccdf:Group") %}
        {% for group in groups %}
            <div class="scap-group requirement {{group.xpath('.//xccdf:Rule/@severity')|first}}">
                <div class="collapse severity">
                    {% if group.xpath('.//xccdf:Rule/@severity')|first == 'high' %}
                        c
                    {% elseif group.xpath('.//xccdf:Rule/@severity')|first == 'medium' %}
                        b
                    {% else %}
                        a
                    {% endif %}
                </div>

                {% if group.xpath('.//xccdf:Rule/xccdf:ident')|filter( v => v.__toString() starts with 'CCI-')|length > 0 %}
                    {% set CCI_NUM = group.xpath('.//xccdf:Rule/xccdf:ident')|filter( v => v.__toString() starts with 'CCI-')|first %}
                {% else %}
                    {% set CCI_NUM = "" %}
                {% endif %}

                <div class="req-header title">
                    {{group.xpath('.//xccdf:Rule/xccdf:title')|first}}
                </div>

                <div class="container-fluid">
                    <div class="row">
                        <dl class="col-2 mb-0 p-0 pl-1 g-0 border border-1 bg-light">
                            <dt class="">RMF Control</dt>
                            <dd class="control">
                            {% if CCI_NUM != '' %}
                                {% set cci_match = cci.xpath("//xmlns:cci_item[@id='" ~ CCI_NUM ~ "']")|first %}
                                {% if cci_match %}
                                    {{ ui.rmf_link(cci_match.references.reference|first.attributes.index|split(' ')|first) }}
                                {% endif %}
                            {% endif %}
                            </dd>

                            <dt class="">Severity</dt>
                            <dd class="">
                                {{ ui.sev(group.xpath('.//xccdf:Rule/@severity')|first) }}
                            </dd>

                            <dt class="">CCI</dt>
                            <dd class="">{% if CCI_NUM != '' %}{{ ui.cci_link(CCI_NUM) }}{% endif %}</dd>

                            <dt class="">Version</dt>
                            <dd class="">{{ ui.ident(group.xpath('.//xccdf:Rule/xccdf:version')|first) }}</dd>

                            <dt class="">Vuln IDs</dt>
                            <dd class="vuln">{{ ui.ident(group.xpath('.//@id')|first|replace({'xccdf_mil.disa.stig_group_':''})) }}</dd>

                            <dt class="">Rule IDs</dt>
                            <dd class="">{{ ui.ident(group.xpath('.//xccdf:Rule/@id')|first|replace({'xccdf_mil.disa.stig_rule_':''})) }}</dd>
                        </dl>
                        <div class="col-10 ">

                            <div class="req-desc">
                                {{group.xpath('.//xccdf:Rule/xccdf:description')|first|replace({'<Documentable>false</Documentable>':''})|regex_replace('/<[^>]*>/is', '' ) }}
                            </div>

                            <h6><u><strong>Fix: </strong>{{ ui.ident(group.xpath('.//xccdf:Rule/xccdf:fix/@id')|first) }}</u></h6>
                            <p class="pre-wrap">{{ group.xpath('.//xccdf:Rule/xccdf:fixtext/text()')|first }}</p>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
        </div>
    </article>
    <script>
        const scap_app = {
            init(){
              $('#scaps').DataTable( {
                dom: '<"top">rt<"bottom"<>p><"clear">',
                pageLength: 25,
                order: [[ 3, "desc" ]],
                colReorder: false,
            } );
            },
            view(){
                if($('#view_scap').val().trim() != ''){
                    const info = $('#view_scap').val().trim().split('|');
                    window.location.href = "{{ path('scap_view', {title: 'XXXX', version: 9999, release: 8888}) }}"
                        .replace('XXXX',"{{title}}")
                        .replace('9999',info[0])
                        .replace('8888',info[1])
                }
            },
            download(){
                window.open( window.location.href + '/download' );
            },
            toggleFilter(elem, level){
                const $groups = $('div.scap-group.' + level);
                if($(elem).hasClass('active')){
                    $groups.removeClass('collapse');
                }else{
                    $groups.removeClass('collapse').addClass('collapse');
                }
            },
            sort(elem){
                const sort_field = $(elem).data('sort');
                $(elem).parent().find('.chip').removeClass('active').attr('aria-checked', 'false');
                $(elem).addClass('active').attr('aria-checked', 'true');

                const itemsArr = $('div.scap-group').toArray();
                itemsArr.sort((a, b) => {
                    const av = $(a).find('.' + sort_field).text().trim();
                    const bv = $(b).find('.' + sort_field).text().trim();
                    return av === bv ? 0 : (av > bv ? 1 : -1);
                });

                const $req = $('div#requirements').empty();
                itemsArr.forEach(e => $req.append(e));
            },
        }

        $(document).ready( () => {
            scap_app.init();
        })
    </script>
{% endblock %}
