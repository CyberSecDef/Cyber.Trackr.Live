{% extends 'base.html.twig' %}
{% import 'macros.html.twig' as ui %}

{% block title %}CCIs!{% endblock %}

{% block body %}
    <section class="lib-page" aria-labelledby="cci-page-title">
        <div class="rule-text">&sect; Library &middot; CCIs</div>

        <header class="lib-page__header">
            <span class="eyebrow">Control Indicators</span>
            <h1 id="cci-page-title" class="lib-page__title-large">
                Common Control <em>Identifiers</em>
            </h1>
            <p class="lib-page__lede">
                {{ results|length|number_format }} CCIs &mdash; the atomic compliance statements behind every STIG rule, mapped to NIST 800-53 controls.
            </p>
        </header>

        <div id="cci_container">
        <table id="ccis" class="cci-table compact w-100">
            <thead>
                <tr>
                    <th>CCI</th>
                    <th>CCI Definition</th>
                    <th>CCI Auditor</th>
                    <th>CCI Guidance</th>
                    <th>Control Name</th>
                    <th>Control</th>
                    <th>Assessment Procedure</th>
                    <th>Control Guidance</th>
                    <th>Control Definition</th>
                </tr>
            </thead>
            <tbody>
                {% for r in results %}
                    <tr>
                        <td>{{ ui.ident(r.cci) }}</td>
                        <td class="pre-wrap">{{r.cci_definition|default()}}</td>
                        <td class="pre-wrap">{{r.cci_auditor|default()}}</td>
                        <td class="pre-wrap">{{r.cci_guidance|default()}}</td>
                        <td>{{r.name|default()}}</td>
                        <td>{% if r.rmf|default %}{{ ui.rmf_link(r.rmf) }}{% endif %}</td>
                        <td>{{r.ap_acronym|default()}}</td>
                        <td class="pre-wrap">{{r.rmf_guidance|default()}}</td>
                        <td class="pre-wrap">{{r.rmf_definition|default()}}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    </section>
    <script>
        const cci_app = {
            init(){
                // Single toolbar at top: filter, length, info, pagination, export buttons.
                // No bottom controls — they only duplicate what's already at top.
                const dt = $('#ccis').DataTable({
                    // Top toolbar: filter | length + export buttons.
                    // Bottom: row count info + pagination (where the eye lands after scrolling).
                    dom: '<"cci-toolbar"<"cci-toolbar__left"f><"cci-toolbar__right"lB>>rt<"cci-foot"<"cci-foot__info"i>p>',
                    pageLength: 10,
                    order: [[ 0, "asc" ]],
                    colReorder: true,
                    // Mobile: collapse low-priority columns into a per-row expand chevron.
                    // CCI id (col 0) always stays visible; the Definition (col 1) and
                    // Control (col 5) drop in next as width allows; everything else
                    // hides first into the child row.
                    responsive: true,
                    columnDefs: [
                        { responsivePriority: 1,     targets: 0 },
                        { responsivePriority: 2,     targets: 1 },
                        { responsivePriority: 3,     targets: 5 },
                        { responsivePriority: 10001, targets: '_all' },
                    ],
                    buttons: [
                        { extend: 'copyHtml5',  text: '<i class="bi bi-copy"></i>',          titleAttr: 'Copy'  },
                        { extend: 'excelHtml5', text: '<i class="bi bi-file-excel"></i>',    titleAttr: 'Excel' },
                        { extend: 'csvHtml5',   text: '<i class="bi bi-filetype-csv"></i>',  titleAttr: 'CSV'   },
                        { extend: 'pdfHtml5',   text: '<i class="bi bi-file-pdf"></i>',      titleAttr: 'PDF',
                          orientation: 'landscape', pageSize: 'LEGAL' },
                        { extend: 'print',      text: '<i class="bi bi-printer"></i>',       titleAttr: 'Print' },
                    ],
                });

                // Deep-link support: /cci#CCI-000366 pre-filters the table to that
                // CCI. Used by ui.cci_link from STIG/SCAP detail pages.
                cci_app.applyHashFilter(dt);
                $(window).on('hashchange', () => cci_app.applyHashFilter(dt));
            },
            applyHashFilter(dt) {
                const hash = (window.location.hash || '').replace(/^#/, '').trim();
                if (/^CCI-\d{6}$/i.test(hash)) {
                    dt.search(hash).draw();
                }
            }
        };

        $(document).ready(() => cci_app.init());
    </script>
{% endblock %}