{% extends 'base.html.twig' %}
{% import 'macros.html.twig' as ui %}

{% block title %}CCIs!{% endblock %}
{% block og_title %}Common Control Identifiers (CCIs){% endblock %}
{% block og_description %}The atomic compliance statements behind every STIG rule, mapped to NIST 800-53 controls — searchable, filterable, and deep-linked from every STIG view.{% endblock %}
{% block og_image_name %}cci{% endblock %}

{% block body %}
    <style>
      /* Revision-aware CCI rows: Rev 5 is the default. Rev-4-only / deprecated rows
         are dimmed, and controls superseded or dropped in Rev 5 are struck through. */
      .cci-row.is-dropped td, .cci-row.is-deprecated td { opacity: .6; }
      .cci-table del { text-decoration: line-through; opacity: .7; }
      .cci-table del .ident { text-decoration: line-through; }
      /* Align every cell to the top of the row (long pre-wrap cells read better). */
      #ccis td, #ccis th { vertical-align: top; }
      /* "Not available" placeholder: muted, so empty-by-design reads as intentional.
         Tap/click reveals the explanatory note (no hover on touch devices). */
      #ccis .cell-na { color: #8a8f98; font-style: italic; cursor: pointer; position: relative; }
      #ccis .cell-na:focus-visible { outline: 2px solid #6ea8fe; outline-offset: 2px; border-radius: 3px; }
      #ccis .cell-na.is-open::after {
        content: attr(data-note);
        position: absolute; left: 0; top: 100%; margin-top: 4px; z-index: 30;
        display: block; width: max-content; max-width: 260px; white-space: normal;
        font-style: normal; color: #fff; background: #1f2329;
        padding: .5rem .625rem; border-radius: 6px;
        font-size: .8rem; line-height: 1.35; box-shadow: 0 4px 14px rgba(0,0,0,.28);
      }
      /* Assessment Procedure cell: one labeled line per source — the 800-53A
         reference and (when present) the DoD AP acronym, stacked. */
      #ccis .ap-line { display: block; }
      #ccis .ap-line + .ap-line { margin-top: .3rem; }
      #ccis .ap-label { color: #8a8f98; font-size: .78rem; font-weight: 600; margin-right: .2rem; }
    </style>
    <section class="lib-page" aria-labelledby="cci-page-title">
        <div class="rule-text">&sect; Library &middot; CCIs</div>

        <header class="lib-page__header">
            <span class="eyebrow">Control Indicators</span>
            <h1 id="cci-page-title" class="lib-page__title-large">
                Common Control <em>Identifiers</em>
            </h1>
            <p class="lib-page__lede">
                <span id="cci-count">&hellip;</span> CCIs &mdash; the atomic compliance statements behind every STIG rule, mapped to NIST 800-53 controls. Defaults to Rev&nbsp;5; Rev-4-only mappings are struck and superseded controls shown alongside.
            </p>
        </header>

        <div id="cci_container">
        {# Rows are loaded client-side from /cci/data (DataTables ajax + deferRender):
           ~5,100 CCIs are too many to server-render into the page DOM. #}
        <table id="ccis" class="cci-table compact w-100">
            <thead>
                <tr>
                    <th>CCI</th>
                    <th>CCI Definition</th>
                    <th>CCI Auditor</th>
                    <th>CCI Guidance</th>
                    <th>Control Name</th>
                    <th>Control</th>
                    <th>Assessment Procedure</th>
                    <th>Control Guidance</th>
                    <th>Control Definition</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        </div>
    </section>
    <script>
        // Deep link to the Rev 5 control page, and the row-data endpoint.
        const RMF5 = "{{ path('rmf_v5_view') }}";
        const CCI_DATA = "{{ path('cci_data') }}";
        // Per-control text (name/definition/guidance), keyed by control id. Populated
        // once from /cci/data instead of being repeated on every CCI row.
        let CTRL = {};

        function esc(s){
            s = (s == null ? '' : String(s));
            return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        }
        function pill(t){ return '<span class="ident">' + esc(t) + '</span>'; }
        function rmf(id){
            return '<a class="ident ident--link" href="' + RMF5 + '#rmf_' + encodeURIComponent(id) +
                   '" title="View ' + esc(id) + ' on the 800-53 Rev 5 page">' + esc(id) + '</a>';
        }
        function ctrlOf(row){ return (row.ctrl && CTRL[row.ctrl]) ? CTRL[row.ctrl] : {}; }
        // Plain-text column: escape for display, raw for sort/filter/export.
        function txt(data, type){ return type === 'display' ? esc(data || '') : (data || ''); }
        // Muted "not available" placeholder with an explanatory note. `title` covers
        // desktop hover; data-note + tabindex make it tap/click/keyboard-revealable on
        // touch devices (see the delegated handler in bindNaNotes()).
        function na(note){
            const n = esc(note);
            return '<span class="cell-na" role="button" tabindex="0" aria-label="' + n +
                   '" title="' + n + '" data-note="' + n + '">&mdash;</span>';
        }
        const NOTE_DOD = "No public per-CCI assessment guidance — DoD's assessment text (eMASS) is not public.";
        const NOTE_CTRL = "No control text available — the referenced control has no Rev 5 / Rev 4 entry.";
        const NOTE_AP = "No 800-53A assessment reference or control mapping available.";
        // Private-use sentinel wrapping struck control ids in the Excel export orthogonal
        // data, so the xlsx customize step can render them as struck-through rich text.
        // Valid XML char, never present in a control id; only the Excel button sees it.
        const STRK = '\uE000';
        // DoD assessment column: the value if present, else the placeholder note.
        function dodCell(data, type){
            if (type !== 'display') return data || '';
            return (data && String(data).trim() !== '') ? esc(data) : na(NOTE_DOD);
        }
        // Assessment Procedure: a labeled line for the 800-53A reference(s) — or the
        // control-ref fallback (Rev 5 -> 4 -> 3) flagged with a "from Rev N" badge — and,
        // when the CCI carries a DoD assessment procedure, a second "DoD AP:" line below it.
        function apCell(data, type, row){
            const a = row.assessment || [];
            // Excel export (orthogonal 'export'): clean labeled text, one item per line.
            if (type === 'export') {
                const parts = [];
                if (a.length) parts.push((row.assessment_src === '1' ? '800-53A: ' : '') + a.join(', '));
                if (row.ap_acronym) parts.push('DoD AP: ' + row.ap_acronym);
                return parts.join('\n');
            }
            // Sort/filter/type: refs plus the DoD AP so the column stays searchable by both.
            if (type !== 'display') return a.join(', ') + (row.ap_acronym ? ' ' + row.ap_acronym : '');
            const lines = [];
            if (a.length) {
                const refs = a.map(pill).join(' ');
                if (row.assessment_src === '1') {
                    lines.push('<span class="ap-label">800-53A:</span>' + refs);
                } else {
                    const label = { '5': 'from Rev 5', '4': 'from Rev 4', '3': 'from Rev 3' }[row.assessment_src];
                    lines.push(refs + (label ? ' ' + pill(label) : ''));
                }
            }
            if (row.ap_acronym) {
                lines.push('<span class="ap-label">DoD AP:</span>' + pill(row.ap_acronym));
            }
            if (!lines.length) return na(NOTE_AP);
            return lines.map(l => '<span class="ap-line">' + l + '</span>').join('');
        }

        const cci_app = {
            init(){
                const dt = $('#ccis').DataTable({
                    ajax: {
                        url: CCI_DATA,
                        // Capture the deduped control map; return the row array to DataTables.
                        dataSrc: json => { CTRL = json.controls || {}; return json.data || []; }
                    },
                    deferRender: true,   // only build DOM nodes for the visible page
                    dom: '<"cci-toolbar"<"cci-toolbar__left"f><"cci-toolbar__right"lB>>rt<"cci-foot"<"cci-foot__info"i>p>',
                    pageLength: 10,
                    order: [[ 0, "asc" ]],
                    colReorder: true,
                    responsive: true,
                    columns: [
                        // CCI id pill (+ deprecated badge).
                        { data: 'cci', render: (d, type, row) => {
                            if (type !== 'display') return d;
                            return pill(d) + (row.deprecated ? ' ' + pill('deprecated') : '');
                        }},
                        { data: 'cci_definition', className: 'pre-wrap', render: txt },
                        { data: 'cci_auditor',    className: 'pre-wrap', render: dodCell },
                        { data: 'cci_guidance',   className: 'pre-wrap', render: dodCell },
                        // Control name (Rev 5 by default) + revision / withdrawn badge.
                        { data: null, render: (d, type, row) => {
                            const c = ctrlOf(row);
                            if (type !== 'display') return c.name || '';
                            let h = c.name ? esc(c.name) : na(NOTE_CTRL);
                            if (row.rev === '4') h += ' ' + pill('Rev 4 only');
                            else if (row.rev === '3') h += ' ' + pill('Rev 3 (legacy)');
                            else if (c.withdrawn) h += ' ' + pill('withdrawn');
                            return h;
                        }},
                        // Control links: Rev 5 live, any differing/dropped Rev 4 struck.
                        { data: null, render: (d, type, row) => {
                            const live = row.controls || [], struck = row.controls_struck || [];
                            // Excel export (orthogonal 'export'): wrap struck ids in the STRK
                            // sentinel so the xlsx customize can strike them through.
                            if (type === 'export') {
                                return live.concat(struck.map(c => STRK + c + STRK)).join(' ');
                            }
                            if (type !== 'display') return live.concat(struck).join(' ');
                            let h = live.map(rmf).join(' ');
                            if (struck.length) {
                                h += (h ? ' ' : '') + struck.map(c =>
                                    '<del title="Mapped under Rev 4; superseded or dropped in Rev 5">' + rmf(c) + '</del>'
                                ).join(' ');
                            }
                            return h;
                        }},
                        { data: null, render: apCell },
                        { data: null, className: 'pre-wrap', render: (d, type, row) => txt(ctrlOf(row).guidance, type) },
                        { data: null, className: 'pre-wrap', render: (d, type, row) => txt(ctrlOf(row).definition, type) },
                    ],
                    columnDefs: [
                        { responsivePriority: 1,     targets: 0 },
                        { responsivePriority: 2,     targets: 1 },
                        { responsivePriority: 3,     targets: 5 },
                        { responsivePriority: 10001, targets: '_all' },
                    ],
                    createdRow: (tr, data) => {
                        tr.classList.add('cci-row');
                        if (data.deprecated) tr.classList.add('is-deprecated');
                        else if (data.rev === '4') tr.classList.add('is-dropped');
                    },
                    buttons: [
                        { extend: 'copyHtml5',  text: '<i class="bi bi-copy"></i>',          titleAttr: 'Copy'  },
                        { extend: 'excelHtml5', text: '<i class="bi bi-file-excel"></i>',    titleAttr: 'Excel',
                          // Use the 'export' orthogonal so the Control column emits STRK
                          // sentinels, then rewrite those cells as struck-through rich text.
                          exportOptions: { orthogonal: 'export' },
                          customize: function(xlsx){ cci_app.strikeExcel(xlsx); } },
                        { extend: 'csvHtml5',   text: '<i class="bi bi-filetype-csv"></i>',  titleAttr: 'CSV'   },
                        { extend: 'pdfHtml5',   text: '<i class="bi bi-file-pdf"></i>',      titleAttr: 'PDF',
                          orientation: 'landscape', pageSize: 'LEGAL' },
                        { extend: 'print',      text: '<i class="bi bi-printer"></i>',       titleAttr: 'Print' },
                    ],
                    initComplete: function(){
                        const api = this.api();
                        $('#cci-count').text(api.page.info().recordsTotal.toLocaleString());
                        cci_app.applyHashFilter(api);
                        cci_app.bindNaNotes();
                        $(window).on('hashchange', () => cci_app.applyHashFilter(api));
                    }
                });
            },
            // Touch devices have no hover, so the placeholder note (title attr) is otherwise
            // unreachable. Make the "—" placeholders reveal their note on tap/click/Enter,
            // with one open at a time and click-away / Esc to dismiss. Delegated, so it also
            // covers rows built later by deferRender and responsive child rows.
            bindNaNotes() {
                const closeAll = () => document.querySelectorAll('#ccis .cell-na.is-open')
                    .forEach(el => el.classList.remove('is-open'));
                $('#ccis').on('click', '.cell-na', function(e){
                    e.stopPropagation();
                    const willOpen = !this.classList.contains('is-open');
                    closeAll();
                    if (willOpen) this.classList.add('is-open');
                });
                $('#ccis').on('keydown', '.cell-na', function(e){
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); $(this).trigger('click'); }
                    else if (e.key === 'Escape') { this.classList.remove('is-open'); }
                });
                $(document).on('click', closeAll);
            },
            applyHashFilter(api) {
                const hash = (window.location.hash || '').replace(/^#/, '').trim();
                if (/^CCI-\d{6}$/i.test(hash)) {
                    api.search(hash).draw();
                }
            },
            // Excel xlsx customize: the Control column's cells arrive with struck control
            // ids wrapped in the STRK sentinel (an <del> tag can't survive into a cell).
            // Rewrite each such cell's <is><t>text</t></is> as rich-text runs, applying a
            // <strike/> run-property to the wrapped segments. Locates the Control column
            // from the header text so it survives colReorder.
            strikeExcel(xlsx) {
                const NS = 'http://schemas.openxmlformats.org/spreadsheetml/2006/main';
                const XMLNS = 'http://www.w3.org/XML/1998/namespace';
                const doc = xlsx.xl.worksheets['sheet1.xml'];
                if (!doc) return;
                const cells = doc.getElementsByTagName('c');
                const refOf = r => { const m = /^([A-Z]+)(\d+)$/.exec(r || ''); return m ? { col: m[1], row: +m[2] } : null; };
                const textOf = c => { const t = c.getElementsByTagName('t')[0]; return t ? t.textContent : null; };

                // Find the "Control" column (and its header row) by header label.
                let col = null, headerRow = null;
                for (let i = 0; i < cells.length; i++) {
                    if (textOf(cells[i]) === 'Control') {
                        const p = refOf(cells[i].getAttribute('r'));
                        if (p) { col = p.col; headerRow = p.row; break; }
                    }
                }
                if (col === null) return;

                for (let i = 0; i < cells.length; i++) {
                    const c = cells[i];
                    const p = refOf(c.getAttribute('r'));
                    if (!p || p.col !== col || p.row <= headerRow) continue;
                    const is = c.getElementsByTagName('is')[0];
                    if (!is) continue;
                    const t = is.getElementsByTagName('t')[0];
                    if (!t) continue;
                    const text = t.textContent;
                    if (text.indexOf(STRK) === -1) continue;
                    while (is.firstChild) is.removeChild(is.firstChild);
                    // Split on the sentinel: odd-indexed segments were the struck ids.
                    text.split(STRK).forEach((seg, idx) => {
                        if (seg === '') return;
                        const r = doc.createElementNS(NS, 'r');
                        if (idx % 2 === 1) {
                            const rPr = doc.createElementNS(NS, 'rPr');
                            rPr.appendChild(doc.createElementNS(NS, 'strike'));
                            r.appendChild(rPr);
                        }
                        const rt = doc.createElementNS(NS, 't');
                        rt.setAttributeNS(XMLNS, 'xml:space', 'preserve');
                        rt.appendChild(doc.createTextNode(seg));
                        r.appendChild(rt);
                        is.appendChild(r);
                    });
                }
            }
        };

        $(document).ready(() => cci_app.init());
    </script>
{% endblock %}
