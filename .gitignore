# DISA SRG-STIG Compilation zips — these are aggregated bundles that can run
# 100+ MB and exceed GitHub's per-file limit. The individual STIG zips in
# resources/data/zips/ stay tracked; only Compilation bundles are excluded.
*Compilation*.zip

# The Symfony app lives in the cyber.trackr.live/ subdirectory, so the
# root-anchored /var/, /vendor/, /node_modules/ rules above don't reach it.
# Ignore its generated/installed directories explicitly.
/cyber.trackr.live/var/
/cyber.trackr.live/vendor/
/cyber.trackr.live/node_modules/
/cyber.trackr.live/.phpunit.cache/

# Air-gapped image tarballs produced by cyber.trackr.live/bin/build-image.sh
# (multi-GB `docker save` output) — generated artifacts, never committed.
/cyber.trackr.live/dist/

# NOTE: the app lives in cyber.trackr.live/, so the generated-data rules below
# must be anchored under that prefix — root-anchored paths (/VERSION, etc.)
# silently match nothing.

# Baked version string written by `php bin/console app:version:freeze` at
# deploy time. Generated, not authored — let dev compute live and let prod
# read the file produced by CI.
/cyber.trackr.live/VERSION

# Inverted search index — generated by `php bin/console app:search:rebuild`
# (or auto-rebuilt after DISA pulls). Can be 100+ MB and rebuildable from
# source data, so we don't track it.
/cyber.trackr.live/resources/data/search/

# STIG digest cache — generated lazily by StigDigestBuilder when a STIG
# view page is hit (or the Atom feed builds). Self-invalidates against
# source XML mtime; rebuildable from the catalog. Don't track.
/cyber.trackr.live/resources/data/stig/*.digest.json

# Auto-rendered data indexes — rebuilt on every ship/refresh-data run and on
# the data-update cron (KEV pull, STIG/SCAP sync). Derived from upstream
# DISA/CISA/NIST sources, not authored here, so they churn constantly and are
# fully rebuildable. The *authored* reference catalogs in resources/data
# (800-53r4.json, 800-53r5.json, overlays/, plans/, rmf/) stay tracked.
/cyber.trackr.live/resources/data/changelog.json
/cyber.trackr.live/resources/data/sync_status.json
/cyber.trackr.live/resources/data/vulns_toc.json
/cyber.trackr.live/resources/data/stig_toc.json
/cyber.trackr.live/resources/data/scap_toc.json
/cyber.trackr.live/resources/data/bulk_download_index.json
/cyber.trackr.live/resources/data/companion_zip_index.json
/cyber.trackr.live/resources/data/kev/*.json

# Local dev convenience router for `php -S` (not used in prod; Apache/.htaccess
# handles routing there). Kept out of the repo so the dev serve helper doesn't ship.
/cyber.trackr.live/router.php
