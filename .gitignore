# DISA SRG-STIG Compilation zips — these are aggregated bundles that can run
# 100+ MB and exceed GitHub's per-file limit. The individual STIG zips in
# resources/data/zips/ stay tracked; only Compilation bundles are excluded.
*Compilation*.zip

# Baked version string written by `php bin/console app:version:freeze` at
# deploy time. Generated, not authored — let dev compute live and let prod
# read the file produced by CI.
/VERSION

# Inverted search index — generated by `php bin/console app:search:rebuild`
# (or auto-rebuilt after DISA pulls). Can be 100+ MB and rebuildable from
# source data, so we don't track it.
/resources/data/search/

# STIG digest cache — generated lazily by StigDigestBuilder when a STIG
# view page is hit (or the Atom feed builds). Self-invalidates against
# source XML mtime; rebuildable from the catalog. Don't track.
/resources/data/stig/*.digest.json
